{
  "firestore": { "rules": "firestore.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "singleProjectMode": true,
    "functions": { "port": 5001 }
  },
  "functions": [
    {
      "source": "firebase-functions",
      "codebase": "notifications",
      "ignore": ["node_modules", "test", ".git", "*.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ]
}
