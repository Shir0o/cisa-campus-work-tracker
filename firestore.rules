rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PRIMITIVES & HELPERS ---
    // A guest-link credential (see /api/guest-doc) is scoped to one RTDB board
    // node. It must never unlock Firestore, so outside RTDB a guest is signed out.
    function isGuest() { return request.auth != null && request.auth.token.get('guest', false) == true; }
    function isSignedIn() { return request.auth != null && !isGuest(); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function emailVerified() { return request.auth.token.email_verified == true; }
    function getAuthEmail() { return request.auth.token.get('email', '').lower(); }

    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Super Admin: Explicitly whitelisted email
    function isSuperAdmin() {
      return isSignedIn() && emailVerified() && getAuthEmail() == 'yilongwang05@gmail.com';
    }

    // Role detection via trusted document lookup
    function getStoredUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getStoredUser().role == role)
      );
    }

    function isAdmin() { return hasRole('admin') || isSuperAdmin(); }
    // An unapproved Trainee — self-registered, revoked, or a downgraded legacy
    // Student/Community account — passes no Trainee gate until approved.
    function isManager() { return isAdmin() || (hasRole('manager') && getStoredUser().approved == true); }

    // Approved AND manager-or-above, resolved from one user-document read.
    // Composing isApprovedUser() && isManager() re-walks isSuperAdmin, exists
    // and getStoredUser up to eight times between them; that preamble consumed
    // almost the entire 1000-expression budget the rules engine allows per
    // request, leaving the contact tie branches unable to evaluate at all — a
    // legitimate collaborator removal was denied in production, not merely in
    // the emulator (#1052 follow-up).
    function isApprovedManager() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getStoredUser().approved == true &&
        getStoredUser().role in ['admin', 'manager']
      );
    }

    function isApprovedUser() {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getStoredUser().approved == true)
      );
    }

    // Contact visibility (#1024 phase 4). Mirrors the client's `seesAllPeople`:
    // Full-timers read the whole roster; everyone else is scoped to the
    // denormalised access list on the contact. `visibleTo` holds every
    // persisted tie -- creator, adder, collaborators, founders, and carers.
    function seesAllContacts() {
      return isAdmin();
    }
    function contactVisibleTo(data) {
      return data.get('visibleTo', []);
    }
    function canReadContact(data) {
      return isApprovedUser() &&
             (seesAllContacts() || request.auth.uid in contactVisibleTo(data));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    // 2. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['email', 'displayName', 'role', 'approved']) &&
               data.email is string && data.email.size() <= 128 &&
               data.displayName is string && data.displayName.size() <= 128 &&
               (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 512)) &&
               data.role in ['admin', 'manager'] &&
               data.approved is bool &&
               (!('weeklyRemindersOff' in data) || data.weeklyRemindersOff is bool) &&
               hasValidTeam(data);
      }

      // Which team they're on (#727) — the division above the gospel-partner
      // pairs. The set of ids lives in src/lib/teams.ts, not here, so adding a
      // third team stays a one-line code change; the rules only insist it is a
      // short string or absent. An unrecognised value reads as unassigned.
      function hasValidTeam(data) {
        return !('team' in data) || data.team == null ||
               (data.team is string && data.team.size() <= 64);
      }

      // A person does not put themselves on a team; a full-timer arranges the
      // teams the same way they arrange the pairs.
      function teamUnchanged() {
        return existing().get('team', null) == incoming().get('team', null);
      }

      // A Trainee never manages Full-timers: they may not grant or remove the
      // Full-timer role, nor change their own role or approval. Only a
      // Full-timer changes those (security audit, Nov 2026).
      function managerRoleChangeAllowed(userId) {
        return incoming().role != 'admin' && existing().role != 'admin' &&
               (!isOwner(userId) ||
                (incoming().role == existing().role && incoming().approved == existing().approved));
      }

      // The weekly reminder switch is each person's own (#1301); even a manager
      // changing someone else's record leaves it exactly as it was.
      function weeklyRemindersOffUnchanged() {
        return existing().get('weeklyRemindersOff', null) == incoming().get('weeklyRemindersOff', null);
      }

      allow get: if isValidId(userId) && (isOwner(userId) || isApprovedUser());
      allow list: if isApprovedUser();
      
      allow create: if isValidId(userId) && isOwner(userId) && 
                      isValidUser(incoming()) &&
                      // Nobody signs themselves onto a team on the way in.
                      (isAdmin() || incoming().get('team', null) == null) &&
                      // Self-registration defaults: unapproved Trainee OR check invitation
                      (
                        (incoming().approved == false && incoming().role == 'manager') || 
                        isAdmin() ||
                        (
                          // The invitation must be for the signed-in, verified
                          // address, or anyone could claim someone else's.
                          emailVerified() &&
                          incoming().email.lower() == getAuthEmail() &&
                          exists(/databases/$(database)/documents/invitations/$(incoming().email.lower())) &&
                          get(/databases/$(database)/documents/invitations/$(incoming().email.lower())).data.role == incoming().role &&
                          get(/databases/$(database)/documents/invitations/$(incoming().email.lower())).data.approved == incoming().approved
                        )
                      );

      allow update: if isValidId(userId) && (
                      (isManager() && (isAdmin() || (teamUnchanged() && managerRoleChangeAllowed(userId))) && weeklyRemindersOffUnchanged() && isValidUser(incoming())) ||
                      (isOwner(userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt', 'pushToken', 'weeklyRemindersOff']) &&
                       incoming().email == existing().email &&
                       incoming().role == existing().role &&
                       incoming().approved == existing().approved &&
                       (!('pushToken' in incoming()) || incoming().pushToken == null ||
                        (incoming().pushToken is string && incoming().pushToken.size() <= 200)) &&
                       isValidUser(incoming()))
                    );
      allow delete: if isValidId(userId) && isAdmin();

      // Personal prayers — private to the owning user; never shared. Powers the
      // "Your prayers" personal list on My Day.
      // Private to the owning person (Nov 2026: managers no longer reach
      // them). The super admin keeps access only so impersonation, which
      // reads as the impersonated person, still works.
      match /personalPrayers/{prayerId} {
        allow read, write, delete: if (isApprovedUser() && isOwner(userId)) || isSuperAdmin();
      }

      // Where this person's alerts are delivered: one doc per device — an Expo
      // token from the native app or a Web Push subscription from a browser /
      // installed PWA. Only the owner registers or removes one; the push
      // dispatcher (a Cloud Function, admin SDK) reads them. Nobody else, staff
      // included, may point your notifications at their device.
      match /pushDevices/{deviceId} {
        function isValidPushDevice(data) {
          return data.updatedAt == request.time && (
            (data.keys().hasOnly(['kind', 'token', 'platform', 'updatedAt']) &&
             data.kind == 'expo' &&
             data.token is string && data.token.size() > 0 && data.token.size() <= 200 &&
             data.platform in ['ios', 'android']) ||
            (data.keys().hasOnly(['kind', 'endpoint', 'keys', 'updatedAt']) &&
             data.kind == 'web' &&
             data.endpoint is string && data.endpoint.size() <= 1024 && data.endpoint.matches('^https://.+') &&
             data.keys.keys().hasOnly(['p256dh', 'auth']) &&
             data.keys.p256dh is string && data.keys.p256dh.size() <= 256 &&
             data.keys.auth is string && data.keys.auth.size() <= 128)
          );
        }
        allow read, delete: if isOwner(userId);
        allow create, update: if isValidId(deviceId) && isOwner(userId) && isValidPushDevice(incoming());
      }
    }

    // 2b. User Preferences — private My Day settings (personal contacts,
    // messaging app) scoped to the owning user.
    // Owner only, plus the super admin for impersonation (Nov 2026).
    match /userPreferences/{userId} {
      allow read, write: if (isApprovedUser() && isOwner(userId)) || isSuperAdmin();
    }

    // 2b-ii. To ask (#1649) — a Full-timer's private notepad of things to ask
    // Trainees in person. Stricter than userPreferences above: only its OWNER
    // may touch it, and only when the owner is a Full-timer (admin). No other
    // Full-timer and no Trainee ever reads or writes it.
    match /toAskNotes/{userId} {
      allow read, write: if isApprovedUser() && isAdmin() && isOwner(userId);
    }

    // 2c. Inbox state — the My Day worklist's two per-person axes, `seen` and
    // `completed` (#813). Same shape and same rule as userPreferences above:
    // it is one private document per person, holding maps of item id → ISO
    // stamp. It lives here rather than as a flag on the contact because the
    // question "have *I* looked at this" cannot be answered by one boolean on
    // a document a dozen Full-timers share.
    match /inboxState/{userId} {
      allow read, write: if (isApprovedUser() && isOwner(userId)) || isSuperAdmin();
    }

    // 3. Invitations Collection
    match /invitations/{email} {
      function isValidInvitation(data) {
        return data.keys().hasAll(['email', 'role', 'approved']) &&
               data.email is string && data.email.size() <= 128 &&
               data.role in ['admin', 'manager'] &&
               data.approved is bool;
      }

      allow get: if isManager() || (isSignedIn() && getAuthEmail() == email.lower());
      allow list: if isManager();
      // Only a Full-timer invites a Full-timer.
      allow create, update: if isManager() && isValidInvitation(incoming()) &&
                              (isAdmin() || incoming().role != 'admin');
      allow delete: if isManager() || (isSignedIn() && getAuthEmail() == email.lower());
    }

    // 4. Contacts Collection
    match /contacts/{contactId} {
      function isValidContact(data) {
        // Optional fields are guarded with `!('x' in data)` first: a partial
        // update (e.g. flipping only `stage`) produces a merged doc that may
        // omit an optional key, and `data.x == null` errors ("Property x is
        // undefined") on an absent key rather than returning false.
        return data.name is string && data.name.size() <= 128 &&
               (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 128)) &&
               (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 32)) &&
               (!('role' in data) || data.role == null || (data.role is string && data.role.size() <= 64)) &&
               (!('location' in data) || data.location == null || (data.location is string && data.location.size() <= 128)) &&
               (!('metVia' in data) || data.metVia == null || (data.metVia is string && data.metVia.size() <= 64)) &&
               (!('stage' in data) || data.stage == null || (data.stage is string && data.stage.size() <= 64)) &&
               (!('inChurchLife' in data) || data.inChurchLife == null || data.inChurchLife is bool) &&
               (!('isStudent' in data) || data.isStudent == null || data.isStudent is bool) &&
               (!('kindSetBy' in data) || data.kindSetBy == null || (data.kindSetBy is string && data.kindSetBy.size() <= 128)) &&
               (!('kindSetAt' in data) || data.kindSetAt == null || (data.kindSetAt is string && data.kindSetAt.size() <= 40)) &&
               (!('visibleTo' in data) || data.visibleTo == null ||
                (data.visibleTo is list && data.visibleTo.size() <= 200)) &&
               (!('prayerListRemoved' in data) || data.prayerListRemoved == null ||
                (data.prayerListRemoved is map &&
                 data.prayerListRemoved.keys().hasOnly(['at', 'by', 'byName']) &&
                 data.prayerListRemoved.keys().hasAll(['at', 'by']) &&
                 data.prayerListRemoved.at is string && data.prayerListRemoved.at.size() <= 40 &&
                 data.prayerListRemoved.by is string && data.prayerListRemoved.by.size() <= 128 &&
                 (!('byName' in data.prayerListRemoved) || data.prayerListRemoved.byName == null ||
                  (data.prayerListRemoved.byName is string && data.prayerListRemoved.byName.size() <= 128))));
      }

      // Read the tie server-side: a Trainee must appear in `visibleTo`, and
      // because the rule is per-document their list query must itself carry
      // `where('visibleTo', 'array-contains', <uid>)` (#1024 phase 4).
      allow read: if canReadContact(resource.data);
      // Anti-abuse Note: Without App Check or an authenticated backend function,
      // this allows unauthenticated creates. Mitigated partially by client-side 
      // honeypot and math captcha on the public form. Acceptable for low-traffic.
      // #1152: the kind of person is a Full-timer's decision, so a create may
      // not assert it. The safe shape — no membership claimed, no stamp — is
      // what the public sign-up form writes, and it passes without a document
      // read; only a create that claims membership or stamps itself pays for
      // the role lookup. #1351: the same goes for a year confirmed for the
      // school year — Years to confirm counts that marker, so only a
      // Full-timer may arrive with it.
      function kindSafeOnCreate(data) {
        return (data.get('inChurchLife', false) == false &&
                !('kindSetBy' in data) && !('kindSetAt' in data) &&
                !('yearConfirmedFor' in data))
               || isAdmin();
      }

      // #1335: the reach stamp says someone logged an interaction with the
      // person or marked them present. A teammate adding a walk-in present may
      // write it; the public sign-up form, filled in by a stranger, may not —
      // signing up is not reach.
      function reachSafeOnCreate(data) {
        return !('reachedAt' in data) || isSignedIn();
      }

      // Nov 2026: who a person is tied to decides which Trainees can read
      // them, so a create may not claim a tie it has no right to. Signed out
      // (the public form), no tie at all: no creator, adder, co-creator,
      // founder or carer, and nobody in visibleTo. Signed in, the creator is
      // the caller, unless a Full-timer is entering it for someone.
      function tiesSafeOnCreate(data) {
        return (!isSignedIn() &&
                !('createdBy' in data) && !('addedBy' in data) &&
                !('coCreators' in data) && !('founders' in data) && !('carers' in data) &&
                (!('visibleTo' in data) || data.visibleTo == null || data.visibleTo.size() == 0))
               || (isSignedIn() &&
                   (!('createdBy' in data) || data.createdBy == request.auth.uid || isAdmin()));
      }

      allow create: if isValidId(contactId) && isValidContact(incoming()) && kindSafeOnCreate(incoming()) &&
                      // #1692: the public sign-up form is filled in by a stranger,
                      // so a create may not arrive already off the team's list.
                      !('prayerListRemoved' in incoming()) &&
                      reachSafeOnCreate(incoming()) &&
                      tiesSafeOnCreate(incoming());
      // Staff edit the typed profile fields; unknown keys are rejected
      // (ghost-field injection). diff().affectedKeys() only inspects the changed
      // keys, so a contact carrying legacy/extra fields stays editable as long as
      // the edit itself touches only known fields. Creation-audit fields
      // (createdAt/createdBy/createdByName/serverCreatedAt) are deliberately
      // omitted so updates cannot rewrite who/when a contact was created; the
      // updatedAt/updatedBy/updatedByName trio stays because the client stamps
      // them on every edit. The lastContactedBy/ById/Date trio is likewise
      // client-stamped whenever an interaction is logged (LogInteractionModal's
      // batch and ContactDetailsModal.handleAddInteraction).
      // Every branch below needs the same handful of expensive sub-expressions:
      // the affected-key set, and the before/after views of coCreators, carers
      // and visibleTo. Recomputing `incoming().diff(existing()).affectedKeys()`
      // and the coCreators set difference once per branch is what pushed a
      // legitimate collaborator removal (#1052) past the rules engine's ceiling
      // of 1000 expression evaluations — the write was denied in production,
      // not merely in the emulator. `let` bindings are evaluated at most once,
      // so the whole decision now costs roughly one branch's worth.
      // A rules function may declare at most ten variables, so the two branches
      // that need the before/after views of every tie get one each.
      function flipsOnlyOwnSheep() {
        let inc = incoming();
        let ex = existing();
        let uid = request.auth.uid;
        let exCarers = ex.get('carers', []).toSet();
        let incCarers = inc.get('carers', []).toSet();
        let exSeen = ex.get('visibleTo', []).toSet();
        let incSeen = inc.get('visibleTo', []).toSet();
        return isAdmin() || (
          uid in ex.get('visibleTo', []) &&
          exSeen.difference(incSeen).hasOnly([uid]) &&
          incSeen.difference(exSeen).hasOnly([uid]) &&
          (
            // taking on: the caller joins the carers, everyone else unchanged
            (uid in inc.get('carers', []) && incCarers.difference(exCarers).hasOnly([uid])) ||
            // giving up: the caller leaves the carers, everyone else unchanged
            (uid in ex.get('carers', []) && exCarers.difference(incCarers).hasOnly([uid]))
          )
        );
      }

      function dropsOnlyOneCollaborator() {
        let inc = incoming();
        let ex = existing();
        let exCo = ex.get('coCreators', []).toSet();
        let incCo = inc.get('coCreators', []).toSet();
        let exCarers = ex.get('carers', []).toSet();
        let incCarers = inc.get('carers', []).toSet();
        let exSeen = ex.get('visibleTo', []).toSet();
        let incSeen = inc.get('visibleTo', []).toSet();
        let coDropped = exCo.difference(incCo);
        return coDropped.size() <= 1 &&
               incCo.difference(exCo).size() == 0 &&
               incCarers.difference(exCarers).size() == 0 &&
               exCarers.difference(incCarers).hasOnly(coDropped) &&
               incSeen.difference(exSeen).size() == 0 &&
               exSeen.difference(incSeen).hasOnly(coDropped);
      }

      // #1526: a tie list may only lose the caller's own uid and never gain
      // anyone. Used by the release branch for carers/coCreators/founders.
      function dropsOnlySelf(field) {
        let inc = incoming().get(field, []).toSet();
        let ex = existing().get(field, []).toSet();
        return inc.difference(ex).size() == 0 &&
               ex.difference(inc).hasOnly([request.auth.uid]);
      }

      function canUpdateContact() {
        let ex = existing();
        let uid = request.auth.uid;
        let keys = incoming().diff(ex).affectedKeys();
        // Only the current holder of the share may rewrite who else can see a
        // person: an admin, an existing co-creator, or a founder (ADR 0022
        // amendment, #1360). The creator (createdBy/addedBy) is deliberately
        // not consulted: the client's canManageCollaborators withholds sharing
        // from them, and the rules follow what the client offers (#1363).
        let admin = isAdmin();
        let mayShare = admin ||
                       uid in ex.get('coCreators', []) ||
                       uid in ex.get('founders', []);
        let exUn = ex.get('unfollowedBy', []).toSet();
        let incUn = incoming().get('unfollowedBy', []).toSet();
        let exSeen = ex.get('visibleTo', []).toSet();
        let incSeen = incoming().get('visibleTo', []).toSet();
        return
          // #1692: "On our hearts" is the team's list. Any approved teammate
          // who can see the person may put someone back (the clear names
          // nobody), while setting the removal must name the caller, so the
          // flag cannot be pinned on someone else. First so this small write
          // short-circuits before the role and tie branches.
          (keys.hasOnly(['prayerListRemoved', 'updatedAt', 'updatedBy', 'updatedByName']) &&
           (incoming().get('prayerListRemoved', null) == null ||
            incoming().prayerListRemoved.by == uid)) ||
          // #1526: Release from my queue. The caller appends only their own uid
          // to `unfollowedBy`, drops only their own tie from
          // carers/coCreators/founders, and rewrites `visibleTo` to match — the
          // self-scoped sibling of the sheep branch below. First so a release
          // write short-circuits true instead of walking every other branch to
          // the 1000-expression ceiling; every other write bails on the
          // `unfollowedBy` presence test before paying the rest.
          (keys.hasAny(['unfollowedBy']) &&
           keys.hasOnly([
             'unfollowedBy', 'visibleTo', 'carers', 'coCreators', 'founders',
             'updatedAt', 'updatedBy', 'updatedByName'
           ]) &&
           uid in ex.get('visibleTo', []) &&
           !(uid in ex.get('unfollowedBy', [])) &&
           uid in incoming().get('unfollowedBy', []) &&
           incUn.difference(exUn).hasOnly([uid]) &&
           exUn.difference(incUn).size() == 0 &&
           incSeen.difference(exSeen).size() == 0 &&
           exSeen.difference(incSeen).hasOnly([uid]) &&
           (!keys.hasAny(['carers']) || dropsOnlySelf('carers')) &&
           (!keys.hasAny(['coCreators']) || dropsOnlySelf('coCreators')) &&
           (!keys.hasAny(['founders']) || dropsOnlySelf('founders'))) ||

          // Staff edit the typed profile fields; unknown keys are rejected
          // (ghost-field injection). affectedKeys() only inspects the changed
          // keys, so a contact carrying legacy/extra fields stays editable as
          // long as the edit itself touches only known fields. Creation-audit
          // fields (createdAt/createdBy/createdByName/serverCreatedAt) are
          // deliberately omitted so updates cannot rewrite who/when a contact
          // was created; the updatedAt/updatedBy/updatedByName trio stays
          // because the client stamps it on every edit, as does the
          // lastContactedBy/ById/Date trio whenever an interaction is logged,
          // and the reach stamp `reachedAt` with it (#1335). `storyMessageIds`
          // is Add to story (#1298): anyone who can see the person may do it,
          // and the visibility gate on `allow update` already asks that.
          keys.hasOnly([
            'name', 'initials', 'role', 'location', 'metVia', 'email', 'phone', 'stage',
            'gender', 'tags', 'notes', 'spiritualBackground', 'pronouns', 'year', 'major',
            'instagram', 'howHeard', 'interests', 'prayerRequest', 'attendance',
            'lastSeen', 'avatar', 'hasNewActivity', 'storyMessageIds',
            'lastContactedBy', 'lastContactedById', 'lastContactedDate', 'reachedAt',
            'updatedAt', 'updatedBy', 'updatedByName'
          ]) ||

          // #1152: the kind of person. Its own branch, Full-timers only, and
          // deliberately not mixable with the profile edit above — otherwise a
          // Trainee's ordinary edit could carry the kind through with it. The
          // stamp moves with the fields it records, so a kind can never be set
          // without saying who decided it.
          //
          // Presence, not change: `affectedKeys()` excludes a key whose value
          // did not change, so requiring the stamp to be *affected* denied a
          // Full-timer re-setting a kind they had already stamped (the bulk-set
          // case) — the write then fell through every remaining branch and
          // exhausted the 1000-expression budget. Checking the incoming map
          // still refuses a kind written with no stamp, and binding kindSetBy to
          // the caller keeps the who-decided-it guarantee.
          //
          // #1351: `year` may ride along, so graduating — no longer a student,
          // and no year — is one write. It adds nothing a Trainee could not
          // already do: `year` is an ordinary profile field.
          (keys.hasOnly([
            'inChurchLife', 'isStudent', 'kindSetBy', 'kindSetAt', 'year',
            'updatedAt', 'updatedBy', 'updatedByName'
          ]) && incoming().keys().hasAll(['kindSetBy', 'kindSetAt']) &&
            incoming().kindSetBy == request.auth.uid && admin) ||

          // Share / unshare: the access list moves in lockstep with the tie it
          // mirrors, so neither can be rewritten as a lone ghost field.
          (keys.hasOnly([
            'coCreators', 'visibleTo',
            'updatedAt', 'updatedBy', 'updatedByName'
          ]) && mayShare) ||

          // #1051: a reader takes a person into (or out of) their sheep. The
          // caller may only flip their own carer membership, may only move
          // themselves in the access list, and must already see the person —
          // taking on never grants reach. An admin may correct anyone.
          (keys.hasOnly([
            'carers', 'visibleTo',
            'updatedAt', 'updatedBy', 'updatedByName'
          ]) && flipsOnlyOwnSheep()) ||

          // #1052: removing a collaborator also drops the carer tie that
          // reached them — an undone share takes the sheep tie with it, in the
          // same write. Removal-only: the write drops at most one collaborator,
          // may drop only their carer tie, and never adds anyone to the access
          // list. A founder who took the person on keeps the tie — that write
          // never touches carers and stays on the share branch above.
          (keys.hasOnly([
            'coCreators', 'carers', 'visibleTo',
            'updatedAt', 'updatedBy', 'updatedByName'
          ]) && mayShare && dropsOnlyOneCollaborator()) ||

          // #1055 & #1103: the founders list and creator attribution are
          // immutable after creation — written once from the pairing. They are
          // rejected as ghost fields for everyone except a Full-timer's
          // genuine-mistake correction (the documented exception). A Full-timer
          // may add, change or remove the founding set and reassign createdBy/createdByName,
          // and must rewrite visibleTo in lockstep so a corrected founding set,
          // creator, and the access they grant never drift. They may also drop
          // the carer tie that only that founder/creator's reach held. Only an
          // admin reaches this branch — it fires only when `founders` or `createdBy`
          // is itself among the affected keys, so a non-admin write touching them is
          // rejected as a ghost field and neither moves for anyone else.
          (keys.hasOnly([
            'founders', 'createdBy', 'createdByName', 'visibleTo',
            'coCreators', 'carers',
            'updatedAt', 'updatedBy', 'updatedByName'
          ]) && admin && keys.hasAny(['founders', 'createdBy'])) ||

          // #1351: Moving up a year. A Full-timer confirms a student's year for
          // the school year — the marker Years to confirm counts. Its own
          // branch, like the kind, so a profile edit cannot carry it; last, so
          // no other write pays for it. The confirmed-by stamp is cut (cut-or-
          // keep §13): it is no longer written or required, but an old-style
          // write that still sets one keeps working, and if it names someone
          // else it is still refused. Presence in the change set, not in the
          // document: an old stamp the write leaves alone is not its business.
          (keys.hasOnly([
            'year', 'yearConfirmedFor', 'yearConfirmedBy', 'yearConfirmedAt',
            'updatedAt', 'updatedBy', 'updatedByName'
          ]) && (!keys.hasAny(['yearConfirmedBy']) || incoming().get('yearConfirmedBy', null) == uid) && admin);
      }

      // #1350: who can see a person is who can change them. This is
      // canReadContact asked of the contact as it stands before the write, so
      // a tie the write removes (giving someone up, leaving a share) still
      // counts and a tie it would add never does. Full-timers see everyone; a
      // Trainee must be on the access list.
      // isApprovedManager() has already proved approval, so the gate skips
      // canReadContact's isApprovedUser() and tests the tie first. Calling
      // canReadContact whole re-walks the role lookups for every writer, and
      // the sheep and collaborator-removal writes were then denied, the
      // 1000-expression ceiling again (#1052).
      allow update: if isValidId(contactId) && isApprovedManager() &&
                      (request.auth.uid in contactVisibleTo(existing()) || seesAllContacts()) &&
                      isValidContact(incoming()) && canUpdateContact();
      // #1350: deleting a person asks the same question — a Trainee may delete
      // only someone they are tied to; a Full-timer anyone.
      allow delete: if isValidId(contactId) && isManager() &&
                      (request.auth.uid in contactVisibleTo(existing()) || seesAllContacts());

      // Interactions and comments are part of the contact's detail page, so
      // they are readable exactly when the contact is -- the canReadContact
      // decision, with the contact fetched only for a Trainee.
      function canReadParentContact() {
        return isApprovedUser() && (
          seesAllContacts() ||
          request.auth.uid in get(/databases/$(database)/documents/contacts/$(contactId)).data.get('visibleTo', [])
        );
      }

      // #1350: writing on a person's page asks the same question as reading
      // it — logging, commenting, posting, editing or removing your own entry,
      // closing an ask, and a Trainee removing someone else's. Like the contact
      // update gate it leaves approval to the rule that calls it and tests the
      // tie first, so a tied Trainee pays one get() and an `in`; Full-timers
      // fall through to seesAllContacts().
      function seesParentContact() {
        return request.auth.uid in contactVisibleTo(get(/databases/$(database)/documents/contacts/$(contactId)).data) ||
               seesAllContacts();
      }

      // Interactions
      match /interactions/{interactionId} {
        function isValidInteraction(data) {
          return data.keys().hasAll(['userId', 'userName', 'content', 'dateTime', 'createdAt']) &&
                 data.userName is string && data.userName.size() <= 128 &&
                 data.content is string && data.content.size() <= 5000 &&
                 (!('reachedById' in data) || (data.reachedById is string && data.reachedById.size() > 0 && data.reachedById.size() <= 128)) &&
                 (!('reachedByName' in data) || (data.reachedByName is string && data.reachedByName.size() <= 128)) &&
                 (!('groupId' in data) || (data.groupId is string && data.groupId.size() > 0 && data.groupId.size() <= 128));
        }

        // "Reached by" (#1288) names the teammate who actually connected with the
        // person, separate from whoever wrote the entry. Naming anyone but
        // yourself is a Full-timer's act; a Trainee may only ever name themselves.
        function isReachedByAllowed(data) {
          return !('reachedById' in data) || data.reachedById == request.auth.uid || isAdmin();
        }

        allow list: if canReadParentContact();
        allow get: if isValidId(interactionId) && canReadParentContact();
        allow create: if isValidId(interactionId) && isApprovedUser() && isManager() && seesParentContact() &&
                        isValidInteraction(incoming()) && 
                        incoming().userId == request.auth.uid && 
                        isReachedByAllowed(incoming()) &&
                        incoming().createdAt == request.time;
        allow update: if isValidId(interactionId) && isApprovedUser() && isManager() && seesParentContact() &&
                        isValidInteraction(incoming()) && 
                        incoming().userId == existing().userId &&
                        (existing().userId == request.auth.uid || isAdmin()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['content', 'dateTime', 'type', 'userName', 'userPhoto']);
        allow delete: if isValidId(interactionId) && isApprovedUser() && seesParentContact() && (isManager() || existing().userId == request.auth.uid);
      }

      // Comments
      match /comments/{commentId} {
        function isValidComment(data) {
          return data.keys().hasAll(['userId', 'userName', 'text', 'createdAt']) &&
                 data.userName is string && data.userName.size() <= 128 &&
                 data.text is string && data.text.size() <= 2000 &&
                 (data.parentId == null || (data.parentId is string && data.parentId.size() <= 128));
        }

        allow read: if canReadParentContact();
        allow create: if isValidId(commentId) && isApprovedUser() && isManager() && seesParentContact() &&
                        isValidComment(incoming()) && 
                        incoming().userId == request.auth.uid && 
                        incoming().createdAt == request.time;
        allow update: if isValidId(commentId) && isApprovedUser() && isManager() && seesParentContact() &&
                        isValidComment(incoming()) && 
                        incoming().userId == existing().userId &&
                        (existing().userId == request.auth.uid || isAdmin()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['text']);
        allow delete: if isValidId(commentId) && isApprovedUser() && seesParentContact() && (isManager() || existing().userId == request.auth.uid);
      }

      function isValidThread(data) {
        return data.keys().hasAll(['from', 'fromName', 'kind', 'body', 'at', 'interactionId']) &&
               (data.get('scope', null) == null || data.get('scope', null) == 'team') &&
               data.from is string && data.from.size() <= 128 &&
               data.fromName is string && data.fromName.size() <= 128 &&
               data.kind in ['note', 'question', 'comment', 'encouragement', 'nudge'] &&
               data.body is string && data.body.size() > 0 && data.body.size() <= 5000 &&
               data.at is string && data.at.size() <= 40 &&
               (data.interactionId == null || (data.interactionId is string && data.interactionId.size() <= 128));
      }

      // Closing a follow-up ask (#813): a `nudge` is one shared open item, so
      // anyone who can see the contact may say they followed up — it closes
      // once, for everyone tied, rather than each of them dismissing a copy.
      // An @mention closes the same way, but only for those it names (a reply
      // or Done) and its sender (Never mind). `closedBy` must be the caller
      // (you cannot record someone else having done it), and only these three
      // keys may move; the body, kind and author stay immutable. Clearing all
      // three is the undo, and is also how the asker retracts ("Never mind").
      function isCloseOfAsk(before, after) {
        return (before.kind == 'nudge' ||
                (before.kind != 'question' &&
                 before.get('mentionedUserIds', []).size() > 0 &&
                 (before.from == request.auth.uid || request.auth.uid in before.get('mentionedUserIds', [])))) &&
               (
                 (after.get('closedBy', null) == request.auth.uid &&
                  after.get('closedAt', null) is string &&
                  after.get('closedAt', null).size() <= 40 &&
                  (after.get('closedByName', null) == null ||
                   (after.get('closedByName', null) is string && after.get('closedByName', null).size() <= 128)))
                 ||
                 (after.get('closedBy', null) == null &&
                  after.get('closedAt', null) == null &&
                  after.get('closedByName', null) == null)
               );
      }

      // Walking-together threads (trainee <-> full-timer). A light conversation
      // attached to the contact (interactionId null) or to one interaction.
      // Legacy Full-timers Discussion documents (`scope: "team"`) may still sit
      // here; the scope clauses below keep them out of a Trainee's read. The
      // `teamThreads` collection itself is cut (cut-or-keep §24) and its
      // documents stay in Firestore, unreachable.
      match /threads/{threadId} {
        // Reading a person's Alongside thread requires being able to read the
        // person. The collection-group rule above still governs the inbox read.
        allow read: if canReadContact(get(/databases/$(database)/documents/contacts/$(contactId)).data) &&
                       (resource.data.get('scope', '') != 'team' || isAdmin());
        allow create: if isValidId(threadId) && isApprovedUser() && isManager() && seesParentContact() &&
                        isValidThread(incoming()) &&
                        incoming().get('scope', null) == null &&
                        incoming().from == request.auth.uid;
        // Reactions have been removed. Body edits: author only, and the edit
        // stamps `editedAt` (kind/from/at are immutable). Closing a follow-up
        // ask (#813) or an @mention: see isCloseOfAsk above.
        allow update: if isValidId(threadId) && isApprovedUser() && isManager() && seesParentContact() &&
                        (resource.data.get('scope', '') != 'team' || isAdmin()) && (
                        (
                          incoming().diff(existing()).affectedKeys().hasOnly(['body', 'editedAt']) &&
                          existing().from == request.auth.uid &&
                          incoming().body is string && incoming().body.size() > 0 && incoming().body.size() <= 5000 &&
                          (incoming().get('editedAt', null) == null ||
                           (incoming().get('editedAt', null) is string && incoming().get('editedAt', null).size() <= 40))
                        )
                        || (
                          incoming().diff(existing()).affectedKeys().hasOnly(['closedBy', 'closedByName', 'closedAt']) &&
                          isCloseOfAsk(existing(), incoming())
                        )
                      );
        allow delete: if isValidId(threadId) && isApprovedUser() && seesParentContact() && (resource.data.get('scope', '') != 'team' || isAdmin()) && (isAdmin() || existing().from == request.auth.uid);
      }

    }

    // 5. Stages Collection
    match /stages/{stageId} {
      function isValidStage(data) {
        return data.keys().hasAll(['label', 'color', 'order']) &&
               data.label is string && data.label.size() <= 64 &&
               data.color is string && data.color.size() <= 64 &&
               data.order is int;
      }

      allow read: if true;
      allow create, update, delete: if isValidId(stageId) && isManager() && (request.method != 'DELETE' ? isValidStage(incoming()) : true);
    }

    // 6. Events Collection
    match /events/{eventId} {
      function isValidEvent(data) {
        return data.keys().hasAll(['name', 'date', 'order']) &&
               data.name is string && data.name.size() <= 128 &&
               data.date is string && data.date.size() <= 64 &&
               data.order is int;
      }

      allow read: if isApprovedUser();
      allow create, update: if isValidId(eventId) && isManager() && isValidEvent(incoming());
      allow delete: if isValidId(eventId) && isManager();
    }

    // 6b. Rhythms — a recurring gathering's own record (name/cadence/location/
    // roster/term). Occasions stay in `events`, carrying `rhythmId` (issue #957 /
    // ADR 0016; replaces the deleted `gatheringTypes` kind taxonomy).
    match /rhythms/{rhythmId} {
      function isValidCadence(c) {
        return c.type in ['weekly', 'monthly'] &&
               c.days is list &&
               (!('monthlyType' in c) || c.monthlyType in ['same-day', 'relative-day']);
      }

      function isValidRhythm(data) {
        return data.keys().hasAll(['name', 'cadence', 'roster', 'termStart', 'termEnd']) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
               isValidCadence(data.cadence) &&
               (!('location' in data) || data.location == null || (data.location is string && data.location.size() <= 128)) &&
               data.roster is list &&
               data.termStart is string && data.termStart.size() <= 64 &&
               data.termEnd is string && data.termEnd.size() <= 64;
      }

      allow read: if isApprovedUser();
      allow create, update: if isValidId(rhythmId) && isManager() && isValidRhythm(incoming());
      allow delete: if isValidId(rhythmId) && isManager();
    }

    // 6c. Settings — small team-wide singletons (e.g. settings/season). Only
    // settings/season is publicly readable, so the public sign-up reflects the
    // active season / club-rush; only managers may change it.
    match /settings/{docId} {
      function isValidSeasonSettings(data) {
        return data.keys().hasOnly(['override', 'clubRush', 'bfa']) &&
               (!('override' in data) || data.override == null ||
                 (data.override is string && data.override.size() <= 32)) &&
               (!('clubRush' in data) || data.clubRush is bool) &&
               (!('bfa' in data) || data.bfa is bool);
      }

      function isValidWalkingSettings(data) {
        return data.keys().hasOnly(['pairs']) &&
               data.pairs is map;
      }

      function isValidPartnerSettings(data) {
        return data.keys().hasOnly(['pairings']) &&
               data.pairings is list;
      }

      function isValidGoalSettings(data) {
        return data.keys().hasOnly(['on', 'count', 'dayGoalUntil']) &&
               (!('on' in data) || data.on is bool) &&
               (!('count' in data) || (data.count is int && data.count >= 1 && data.count <= 20)) &&
               // The goal switches itself off after this local day (#544,
               // Nov 2026); clearing the date stores null, which hides it.
               (!('dayGoalUntil' in data) || data.dayGoalUntil == null ||
                 (data.dayGoalUntil is string && data.dayGoalUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
      }

      // The weekly reminder schedule (#1301): one time (campus weekdays + hour)
      // for Full-timers and one per team. The team ids match src/lib/teams.ts;
      // the rule only insists each time is well-formed.
      function isValidReminderTime(t) {
        return t is map &&
               t.keys().hasOnly(['days', 'hour']) &&
               t.days is list && t.days.size() <= 7 &&
               t.days.hasOnly([0, 1, 2, 3, 4, 5, 6]) &&
               t.hour is int && t.hour >= 0 && t.hour <= 23;
      }

      function isValidReminderSchedule(data) {
        return data.keys().hasOnly(['fullTimers', 'teams']) &&
               isValidReminderTime(data.fullTimers) &&
               data.teams is map && data.teams.keys().hasOnly(['yp', 'campus']) &&
               (!('yp' in data.teams) || isValidReminderTime(data.teams.yp)) &&
               (!('campus' in data.teams) || isValidReminderTime(data.teams.campus));
      }

      function isValidIntegrationsSettings(data) {
        return data.keys().hasOnly(['attdSyncToken', 'attdSyncTokenHash', 'attdSyncUrl', 'updatedAt', 'updatedBy']) &&
               (!('attdSyncToken' in data) || data.attdSyncToken == null ||
                 (data.attdSyncToken is string && data.attdSyncToken.size() <= 256)) &&
               // The token is stored as its SHA-256 digest (ADR 0052): exactly 64
               // lowercase hex characters, never the plaintext. `attdSyncToken`
               // above stays only until the migration has run everywhere.
               (!('attdSyncTokenHash' in data) || data.attdSyncTokenHash == null ||
                 (data.attdSyncTokenHash is string &&
                  data.attdSyncTokenHash.matches('^[a-f0-9]{64}$'))) &&
               (!('attdSyncUrl' in data) || data.attdSyncUrl == null ||
                 (data.attdSyncUrl is string && data.attdSyncUrl.size() <= 512));
      }

      // The Full-timer-edited standard tags list (#1437, ADR 0039): one ordered
      // list serving the suggestion chips and the combine targets. Season tags
      // are standard by pattern and are never stored here.
      function isValidStandardTagsSettings(data) {
        return data.keys().hasOnly(['tags']) &&
               data.tags is list && data.tags.size() <= 200;
      }

      allow create, update: if docId == 'integrations' && isAdmin() && isValidIntegrationsSettings(incoming());
      allow create, update: if docId == 'reminder_schedule' && isAdmin() && isValidReminderSchedule(incoming());

      // Standard tags are readable by approved users, not the public.
      // Only the season (the public sign-up form reads it) stays readable
      // without signing in. Everything else, pairings, walking pairs, goals and
      // reminder times included, needs an approved member (Nov 2026);
      // integrations stays Full-timer only.
      allow read: if docId == 'season';
      allow read: if docId != 'integrations' && isApprovedUser();
      allow read: if isAdmin();
      allow read: if docId == 'standard_tags' && isApprovedUser();
      allow create, update: if docId == 'standard_tags' && isAdmin() && isValidStandardTagsSettings(incoming());
      allow create, update: if docId == 'season' && isManager() && isValidSeasonSettings(incoming());
      allow create, update: if docId == 'walking' && isAdmin() && isValidWalkingSettings(incoming());
      allow create, update: if docId == 'partners' && isAdmin() && isValidPartnerSettings(incoming());
      // A doc still carrying the legacy `byTerm` map is kept as the migration
      // path (src/lib/partners.ts writes `pairings` with merge, so `byTerm`
      // rides along). Without this, the strict shape above denied every save of
      // such a doc. The update may touch `pairings` only; `byTerm` stays as it is.
      allow update: if docId == 'partners' && isAdmin() &&
                      incoming().keys().hasOnly(['pairings', 'byTerm']) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['pairings']) &&
                      incoming().pairings is list;
      allow create, update: if docId == 'goal' && isAdmin() && isValidGoalSettings(incoming());
      allow delete: if false;
    }

    // 6c-ii. Credential vault (ADR 0051, #1605/#1966) — the team's shared
    // logins, encrypted in the browser. Only Full-timers read or write any of
    // it, and Firestore only ever holds ciphertext: a write carrying a
    // plaintext field (label, username, password) is refused by `hasOnly`, so
    // the boundary does not depend on the client choosing to encrypt.
    match /credentialsMeta/{docId} {
      // One singleton: the salt, KDF cost, check value and schema version the
      // whole vault is derived from. Both stamps are pinned to the request so a
      // rekey cannot backdate the meta its entries were written against.
      function isValidCredentialsMeta(data) {
        return data.keys().hasAll(['salt', 'iterations', 'check', 'schemaVersion', 'createdAt', 'updatedAt']) &&
               data.keys().hasOnly(['salt', 'iterations', 'check', 'schemaVersion', 'createdAt', 'updatedAt']) &&
               data.salt is string && data.salt.size() > 0 && data.salt.size() <= 128 &&
               data.iterations is int && data.iterations > 0 &&
               data.check is string && data.check.size() > 0 && data.check.size() <= 512 &&
               data.schemaVersion is int && data.schemaVersion > 0 &&
               data.createdAt == request.time && data.updatedAt == request.time;
      }

      allow read: if isAdmin();
      allow create, update: if docId == 'current' && isAdmin() && isValidCredentialsMeta(incoming());
      allow delete: if false;
    }

    match /credentials/{credentialId} {
      // One entry, one encrypted JSON blob: no per-field ciphertext and no
      // plaintext key at all. `updatedAt` must be the request time, so an edit
      // that omits it falls back to the stored stamp and is refused (the Dirty
      // Dozen #12 shape); a create must also stamp `createdAt` from the request,
      // and an update may not rewrite it.
      function isValidCredential(data) {
        return data.keys().hasAll(['iv', 'ciphertext', 'createdAt', 'updatedAt']) &&
               data.keys().hasOnly(['iv', 'ciphertext', 'createdAt', 'updatedAt']) &&
               data.iv is string && data.iv.size() > 0 && data.iv.size() <= 64 &&
               data.ciphertext is string &&
               data.ciphertext.size() > 0 && data.ciphertext.size() <= 700000 &&
               data.updatedAt == request.time;
      }

      allow read: if isAdmin();
      allow create: if isValidId(credentialId) && isAdmin() && isValidCredential(incoming()) &&
                       incoming().createdAt == request.time;
      allow update: if isValidId(credentialId) && isAdmin() && isValidCredential(incoming()) &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(credentialId) && isAdmin();
    }

    // The vault's activity log is cut (cut-or-keep §3): credentialAudit has no
    // match. Login entries themselves stay where they are.

    // 6d. Attendance Sync Intake - staged attd pushes, alias memory, and
    // remembered attd event -> Rhythm mappings. Only Full-timers ever read or
    // resolve these; the service writes the staged doc with the Admin SDK.
    match /pending_attendance_imports/{importId} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    match /attendee_aliases/{aliasId} {
      allow read, write: if isAdmin();
    }

    match /integrations_attd_event_mappings/{mappingId} {
      allow read, write: if isAdmin();
    }

    // Combine records (ADR 0038, issue #1427): a permanent snapshot of a
    // contact combine. Full-timers read them; they are written only by the
    // server (the Admin SDK bypasses rules), never from a browser.
    match /combineRecords/{recordId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Not the same person marks (ADR 0038, issue #1432): a Full-timer's
    // remembered judgement that a detected pair is two different people. They
    // create and delete marks from the browser; only Full-timers may.
    match /notSamePersonMarks/{markId} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }

    // 7. Activities Collection
    match /activities/{activityId} {      function isValidActivity(data) {
        return data.userId == request.auth.uid &&
               data.userName is string && data.userName.size() <= 128 &&
               data.action is string && data.action.size() <= 256 &&
               data.targetType in ['contact', 'event', 'comment', 'interaction'] &&
               data.type in ['call', 'email', 'event', 'alert', 'edit', 'create', 'comment'];
      }
      // An entry is data about its target (targetName, a stage change in
      // description), so it is readable exactly when that contact is -- the
      // canReadContact decision, with the contact fetched only for a Trainee.
      // A Trainee's list must therefore pin targetId (Contact Detail's
      // history); the whole feed and non-contact entries stay with the roles
      // that see every person.
      allow read: if isApprovedUser() && (
                    seesAllContacts() ||
                    request.auth.uid in get(/databases/$(database)/documents/contacts/$(resource.data.targetId)).data.get('visibleTo', [])
                  );
      allow create: if isValidId(activityId) && isApprovedUser() && isManager() && isValidActivity(incoming());
      allow update, delete: if isValidId(activityId) && isManager();
    }

    // 8. Notifications Collection
    match /notifications/{notificationId} {
      function isValidNotification(data) {
        return data.userId is string &&
               data.title is string && data.title.size() <= 128 &&
               data.message is string && data.message.size() <= 512 &&
               data.type in ['info', 'success', 'warning', 'error', 'assignment', 'event'] &&
               data.read is bool &&
               data.createdAt == request.time &&
               (!('coalesceKey' in data) || (data.coalesceKey is string && data.coalesceKey.size() <= 200));
      }

      // A user reads only their own notifications; Full-timers (isAdmin) read
      // everything, including the ALL_ADMINS broadcasts. Trainees (manager) are
      // deliberately not staff here.
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // A signed-out visitor may not write here at all: the public sign-up
      // form's ALL_ADMINS alert is written by the server (/api/signup-notify),
      // so a stranger cannot push arbitrary alerts to every Full-timer.
      allow create: if isValidId(notificationId) && isValidNotification(incoming()) &&
                      isApprovedUser() && isManager();
      
      // Full-timers' blanket access covers marking read / dismissing ALL_ADMINS broadcasts.
      allow update: if isValidId(notificationId) && isSignedIn() && (
                      (resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readBy'])) ||
                      isAdmin()
                    );
      
      allow delete: if isValidId(notificationId) && (isOwner(resource.data.userId) || isAdmin());
    }

    // 9. Prayers Collection
    match /prayers/{prayerId} {
      function isValidPrayer(data) {
        return data.keys().hasAll(['contactId', 'updatedAt']) && isValidId(data.contactId) &&
               (!('date' in data) || (data.date is string && data.date.size() <= 64)) &&
               (!('burden' in data) || (data.burden is string && data.burden.size() <= 10000)) &&
               (!('answer' in data) || (data.answer is string && data.answer.size() <= 10000)) &&
               (!('answeredPhotos' in data) || (data.answeredPhotos is list && data.answeredPhotos.size() <= 4)) &&
               (!('status' in data) || data.status in ['pending', 'answered', 'ongoing', 'unanswered']) &&
               (!('prayedFor' in data) || (data.prayedFor is string && data.prayedFor.size() <= 10000)) &&
               (!('unanswered' in data) || (data.unanswered is string && data.unanswered.size() <= 10000)) &&
               (!('prayerPage' in data) || data.prayerPage is bool) &&
               // Whether the team carries this burden. Absent means the team's,
               // so this validates the shape only — surfacing is the app's call,
               // not an access boundary (every approved user still reads it).
               (!('teamPrayer' in data) || data.teamPrayer is bool) &&
               (!('updatedAt' in data) || data.updatedAt is string);
      }

      allow get: if isApprovedUser();
      allow list: if isApprovedUser();
      allow create, update: if isApprovedUser() && isManager() && isValidPrayer(incoming());
      allow delete: if isManager();
    }

    // 9b. Prayer Requests — a Student or Community member asking the team to
    // pray for THEM (mobile v2's member app). Distinct from /prayers, which
    // hangs off a contactId: the asker is a user account, not a contact. The
    // asker owns their rows; staff (manager and up) read every row, which is
    // how the ask reaches the Full-timer home's "Prayers to carry".
    match /prayerRequests/{requestId} {
      function isValidPrayerRequest(data) {
        return data.keys().hasAll(['uid', 'name', 'body', 'status', 'createdAt', 'updatedAt']) &&
               isValidId(data.uid) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
               data.body is string && data.body.size() > 0 && data.body.size() <= 5000 &&
               data.status in ['open', 'answered'] &&
               data.createdAt is string && data.createdAt.size() <= 64 &&
               data.updatedAt is string && data.updatedAt.size() <= 64;
      }

      allow get: if isApprovedUser() && (isOwner(existing().uid) || isManager());
      // The member's own list filters on uid; the staff list filters on status.
      // Both are approved-user reads — a member listing everyone's requests is
      // the one thing this opens up, and these are asks meant for the team.
      allow list: if isApprovedUser();
      allow create: if isApprovedUser() && isOwner(incoming().uid) && isValidPrayerRequest(incoming());
      // "God answered this" is the asker's to say; staff can close one out too.
      allow update: if isApprovedUser() && (isOwner(existing().uid) || isManager()) &&
                      isValidPrayerRequest(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(existing().uid) || isManager();
    }

    // 9c. Hospitality Offers — a Community member's standing offer to host
    // students at their table (mobile v2's "Open your home"). Doc id IS the
    // uid, so one household has one offer.
    match /hospitalityOffers/{userId} {
      function isValidOffer(data) {
        return data.keys().hasAll(['uid', 'name', 'availability', 'seats', 'note', 'updatedAt']) &&
               data.uid == userId &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
               data.availability is list && data.availability.size() <= 8 &&
               data.seats is string && data.seats.size() <= 128 &&
               data.note is string && data.note.size() <= 2000 &&
               data.updatedAt is string && data.updatedAt.size() <= 64;
      }

      allow get: if isApprovedUser() && (isOwner(userId) || isManager());
      // Staff list every open home; a member only ever reads their own doc by
      // id, so the list rule is staff-only.
      allow list: if isManager();
      allow create, update: if isApprovedUser() && isOwner(userId) && isValidOffer(incoming());
      allow delete: if isOwner(userId) || isManager();
    }

    // 10. Tasks Collection
    match /tasks/{taskId} {
      function isValidTask(data) {
        return data.title is string && data.title.size() <= 500 &&
               (data.get('dueDate', null) == null || (data.get('dueDate', null) is string && data.get('dueDate', null).size() <= 40)) &&
               data.status in ['pending', 'completed', 'canceled'] &&
               data.priority in ['low', 'medium', 'high'] &&
               (data.get('contactId', null) == null || (data.get('contactId', null) is string && data.get('contactId', null).size() <= 128)) &&
               (data.get('contactName', null) == null || (data.get('contactName', null) is string && data.get('contactName', null).size() <= 128)) &&
               (data.get('assigneeId', null) == null || (data.get('assigneeId', null) is string && data.get('assigneeId', null).size() <= 128)) &&
               (data.get('sourceInteractionId', null) == null || (data.get('sourceInteractionId', null) is string && data.get('sourceInteractionId', null).size() <= 128)) &&
               (data.get('sourceInteractionTitle', null) == null || (data.get('sourceInteractionTitle', null) is string && data.get('sourceInteractionTitle', null).size() <= 256)) &&
               (data.get('createdById', null) == null || (data.get('createdById', null) is string && data.get('createdById', null).size() <= 128)) &&
               (data.get('createdByName', null) == null || (data.get('createdByName', null) is string && data.get('createdByName', null).size() <= 128)) &&
               (data.get('sourceDocId', null) == null || (data.get('sourceDocId', null) is string && data.get('sourceDocId', null).size() <= 128)) &&
               (data.get('sourceDocTitle', null) == null || (data.get('sourceDocTitle', null) is string && data.get('sourceDocTitle', null).size() <= 256));
      }
      allow list, get: if isApprovedUser();
      allow create, update: if isApprovedUser() && isManager() && isValidTask(incoming());
      allow delete: if isManager() || isSuperAdmin();
    }

    // 11. Feedback Collection
    match /feedback/{feedbackId} {
      function isValidFeedback(data) {
        return data.keys().hasAll(['userId', 'type', 'message', 'status', 'createdAt']) &&
               data.userId == request.auth.uid &&
               (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 128)) &&
               (!('reporterLabel' in data) || (data.reporterLabel is string && data.reporterLabel.size() <= 100)) &&
               data.type in ['bug', 'enhancement'] &&
               (!('kind' in data) || data.kind in ['thought', 'idea', 'off', 'request']) &&
               data.message is string && data.message.size() <= 5000 &&
               data.status in ['new', 'in_progress', 'resolved'] &&
               data.createdAt == request.time &&
               (!('githubIssueUrl' in data) || (data.githubIssueUrl is string && data.githubIssueUrl.size() <= 1000)) &&
               (!('url' in data) || (data.url is string && data.url.size() <= 2000)) &&
               (!('screenshot' in data) || (data.screenshot is string && data.screenshot.size() <= 200000)) &&
               (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 1000)) &&
               (!('viewport' in data) || (data.viewport is string && data.viewport.size() <= 100)) &&
               (!('archived' in data) || data.archived is bool);
      }

      // A submitter reads their own Notes (ADR 0019): the notes page queries
      // `where userId == uid`, and `list` is evaluated per candidate document,
      // so a filtered query succeeds while an unfiltered one is refused.
      // `status`/`githubIssueUrl` reach the author's client as a consequence —
      // the view withholds them, the rules no longer do.
      allow get, list: if isAdmin() ||
                          (isApprovedUser() && isOwner(resource.data.userId));
      allow create: if isValidId(feedbackId) && isApprovedUser() && isValidFeedback(incoming());
      allow update: if isValidId(feedbackId) && isAdmin() &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'githubIssueUrl', 'archived']) &&
                      incoming().status in ['new', 'in_progress', 'resolved'] &&
                      (!('githubIssueUrl' in incoming()) || (incoming().githubIssueUrl is string && incoming().githubIssueUrl.size() <= 1000 || incoming().githubIssueUrl == null)) &&
                      (!('archived' in incoming()) || incoming().archived is bool);
      allow delete: if isValidId(feedbackId) && isAdmin();
    }

    // 12. Coordination Notes Collection
    match /coordination_notes/{noteId} {
      function isValidCoordinationNote(data) {
        return data.keys().hasAll(['title', 'date', 'content', 'category', 'todos']) &&
               data.title is string && data.title.size() <= 200 &&
               data.date is string && data.date.size() <= 64 &&
               data.content is string && data.content.size() <= 100000 &&
               data.category is string && data.category.size() <= 64 &&
               data.todos is list &&
               (!('archived' in data) || data.archived is bool);
      }

      allow get, list: if isAdmin();
      allow create: if isValidId(noteId) && isAdmin() && isValidCoordinationNote(incoming());
      allow update: if isValidId(noteId) && isAdmin() && isValidCoordinationNote(incoming());
      allow delete: if isValidId(noteId) && isAdmin();
    }

    // 14. The Board — coordination sessions (agenda + delegated tasks embedded)
    match /board_sessions/{sessionId} {
      function isValidBoardSession(data) {
        return data.keys().hasAll(['event', 'date', 'time', 'place', 'agenda', 'assigned']) &&
               data.event is string && data.event.size() <= 200 &&
               data.date is string && data.date.size() <= 64 &&
               data.time is string && data.time.size() <= 64 &&
               data.place is string && data.place.size() <= 200 &&
               data.agenda is list && data.agenda.size() <= 200 &&
               data.assigned is list && data.assigned.size() <= 200 &&
               (!('facilitatorId' in data) || (data.facilitatorId is string && data.facilitatorId.size() <= 128));
      }

      allow get, list: if isAdmin();
      allow create: if isValidId(sessionId) && isAdmin() && isValidBoardSession(incoming());
      allow update: if isValidId(sessionId) && isAdmin() && isValidBoardSession(incoming());
      allow delete: if isValidId(sessionId) && isAdmin();
    }

    // 15. The Board — the Notes & learnings archive is cut (cut-or-keep §19),
    // so board_notes has no match. Stored notes stay where they are.

    // 16. The Board — dated Markdown pages (one running doc per gathering)
    match /board_docs/{docId} {
      function isValidBoardDoc(data) {
        return data.keys().hasAll(['date', 'title', 'md']) &&
               data.date is string && data.date.size() <= 64 &&
               data.title is string && data.title.size() <= 200 &&
               data.md is string && data.md.size() <= 100000 &&
               (!('facilitatorId' in data) || (data.facilitatorId is string && data.facilitatorId.size() <= 128)) &&
               (!('place' in data) || (data.place is string && data.place.size() <= 200)) &&
               (!('time' in data) || (data.time is string && data.time.size() <= 64)) &&
               (!('audience' in data) || data.audience in ['team', 'trainees', 'everyone']);
      }

      // Full-timers only (cut-or-keep §19): a Trainee reads no page, whatever
      // its audience. The guest-link read bypasses these rules through the
      // Admin SDK (/api/guest-doc), so a shared page still opens for its key.
      allow get, list: if isAdmin();
      allow create: if isValidId(docId) && isAdmin() && isValidBoardDoc(incoming());
      allow update: if isValidId(docId) && isAdmin() && isValidBoardDoc(incoming());
      allow delete: if isValidId(docId) && isAdmin();
    }

    // 17. Announcements — cut-or-keep §20. A Full-timer posts; every approved
    // Full-timer and Trainee reads and says "Got it" for themselves, and that is
    // all anyone but a Full-timer deleting it may change. `gotIt` maps a uid to
    // the server time that person said it. Chats are gone: the chatRooms path
    // has no match and is closed to everyone.
    match /announcements/{announcementId} {
      function isValidAnnouncement(data) {
        return data.keys().hasOnly(['body', 'authorId', 'authorName', 'createdAt', 'gotIt']) &&
               data.keys().hasAll(['body', 'authorId', 'authorName', 'createdAt', 'gotIt']) &&
               data.body is string && data.body.size() >= 1 && data.body.size() <= 2000 &&
               data.authorId == request.auth.uid &&
               data.authorName is string && data.authorName.size() <= 128 &&
               data.createdAt == request.time &&
               data.gotIt is map && data.gotIt.size() == 0;
      }

      // Only your own entry may be added, once, as the server's time. Nothing
      // else on the announcement moves, and nobody's Got it is taken back.
      function isOwnGotIt() {
        let entries = incoming().gotIt.diff(existing().gotIt);
        return incoming().diff(existing()).affectedKeys().hasOnly(['gotIt']) &&
               !(request.auth.uid in existing().gotIt) &&
               entries.affectedKeys().hasOnly([request.auth.uid]) &&
               entries.addedKeys().hasOnly([request.auth.uid]) &&
               incoming().gotIt[request.auth.uid] == request.time;
      }

      allow get, list: if isApprovedManager();
      allow create: if isValidId(announcementId) && isApprovedManager() && isAdmin() &&
                       isValidAnnouncement(incoming());
      allow update: if isValidId(announcementId) && isApprovedManager() && isOwnGotIt();
      allow delete: if isValidId(announcementId) && isApprovedManager() && isAdmin();
    }

    // 19. Bible Study Meetings — public QR accessible reading documents
    match /bible_study_meetings/{meetingId} {
      function isValidMeeting(data) {
        return data.keys().hasAll(['studyId', 'date', 'title', 'published']) &&
               data.studyId is string && data.studyId.size() <= 128 &&
               data.date is string && data.date.size() <= 64 &&
               data.title is string && data.title.size() <= 200 &&
               data.published is bool &&
               (!('md' in data) || (data.md is string && data.md.size() <= 100000));
      }

      // Public unauthenticated read of published meetings. Drafts readable only by staff (admins).
      allow get: if (resource.data.published == true) || isAdmin();
      allow list: if (resource.data.published == true) || isAdmin();

      // Only Full-timers (admin) can create, edit, publish, or delete. Anonymous write is strictly denied.
      allow create: if isValidId(meetingId) && isAdmin() && isValidMeeting(incoming());
      allow update: if isValidId(meetingId) && isAdmin() && isValidMeeting(incoming());
      // A Meeting may be hard-deleted only while unpublished (ADR 0011): a
      // published one may already be on a student's screen, so pulling it
      // back is two deliberate acts — unpublish, then delete.
      allow delete: if isValidId(meetingId) && isAdmin() && existing().get('published', false) != true;
    }

    // 19a. Bible Study Studies — the named arc ("Romans, Fall 2026") a set of
    // Meetings belongs to. Publicly readable so an anonymous scan can resolve
    // its active Study; writable only by Full-timers.
    match /bible_study_studies/{studyId} {
      function isValidStudy(data) {
        return data.keys().hasAll(['title', 'term']) &&
               data.title is string && data.title.size() <= 200 &&
               data.term is string && data.term.size() <= 64 &&
               data.keys().hasOnly(['title', 'term', 'createdAt', 'updatedAt', 'createdBy']);
      }

      allow get: if true;
      allow list: if true;
      allow create: if isValidId(studyId) && isAdmin() && isValidStudy(incoming());
      allow update: if isValidId(studyId) && isAdmin() && isValidStudy(incoming());
      allow delete: if isAdmin();
    }

    // 19b. Bible Study Entry points — the durable slug a QR encodes
    // (/s/cisa-wednesday). The slug is the document id and never changes;
    // starting a new term is a change of activeStudyId. Publicly readable so
    // an anonymous scan can resolve the chain; writable only by Full-timers.
    match /bible_study_entry_points/{entryPointId} {
      function isValidEntryPoint(data) {
        return data.keys().hasAll(['slug', 'name', 'activeStudyId']) &&
               data.slug is string && data.slug.size() <= 64 &&
               data.name is string && data.name.size() <= 200 &&
               data.slug == entryPointId &&
               ((data.activeStudyId is string && data.activeStudyId.size() <= 128) ||
                data.activeStudyId == null) &&
               data.keys().hasOnly(['slug', 'name', 'activeStudyId', 'createdAt', 'updatedAt', 'createdBy']);
      }

      allow get: if true;
      allow list: if true;
      allow create: if isValidId(entryPointId) && isAdmin() && isValidEntryPoint(incoming());
      allow update: if isValidId(entryPointId) && isAdmin() && isValidEntryPoint(incoming());
      allow delete: if isAdmin();
    }

    // Collection Group helpers. A collection-group list spans every contact
    // and cannot pin a parent to check visibleTo against, so it is for the
    // roles that see every person; a Trainee lists one visible contact's
    // subcollection at a time through the nested rules above.
    match /{path=**}/interactions/{interactionId} {
      allow list: if isApprovedUser() && seesAllContacts();
    }
    match /{path=**}/comments/{commentId} {
      allow list: if isApprovedUser() && seesAllContacts();
    }
    // Walking-together threads — collection-group list for the full-timer inbox
    // (My Day), which reads thread messages across all contacts at once. Like
    // interactions and comments it is for the roles that see every person; a
    // Trainee lists one visible contact's threads at a time through the nested
    // contacts/{id}/threads rule, which also governs get/write. Team-scope
    // Discussion is only visible to Full-timers here too.
    match /{path=**}/threads/{threadId} {
      allow list: if isApprovedUser() && seesAllContacts() &&
                     (resource.data.get('scope', '') != 'team' || isAdmin());
    }
  }
}
