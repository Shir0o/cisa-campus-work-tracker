rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email.lower() == 'yilongwang05@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isApprovedUser() {
      return isSignedIn() && (
        (request.auth.token.email.lower() == 'yilongwang05@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.@+\\-]+$');
    }

    // 2. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.email is string && data.email.size() <= 100 &&
               data.displayName is string && data.displayName.size() <= 100 &&
               (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 512)) &&
               data.approved is bool &&
               (data.role == 'admin' || data.role == 'community_manager');
      }

      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && 
                      request.resource.data.keys().hasAll(['email', 'displayName', 'photoURL', 'approved', 'role']) &&
                      isValidUser(request.resource.data) &&
                      (request.resource.data.approved == false || isAdmin()) &&
                      (request.resource.data.role == 'community_manager' || isAdmin());
      allow update: if (isAdmin() && isValidUser(request.resource.data)) || 
                      (isOwner(userId) && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']) &&
                       request.resource.data.email == resource.data.email &&
                       request.resource.data.role == resource.data.role &&
                       request.resource.data.approved == resource.data.approved &&
                       isValidUser(request.resource.data));
      allow delete: if isAdmin();
    }

    // 3. Invitations Collection
    match /invitations/{email} {
      function isValidInvitation(data) {
        return data.email is string && data.email.size() <= 100 &&
               (data.role == 'admin' || data.role == 'community_manager') &&
               data.approved is bool &&
               data.invitedBy is string &&
               data.createdAt is timestamp;
      }

      allow get: if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == email.lower());
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidEmailId(email) && isValidInvitation(request.resource.data);
      allow update: if isAdmin() && isValidEmailId(email) && isValidInvitation(request.resource.data);
      allow delete: if isAdmin();
    }

    // 4. Contacts Collection
    match /contacts/{contactId} {
      function isValidContact(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 100;
      }

      allow read: if isAdmin() || isApprovedUser();
      allow create: if (isAdmin() || isApprovedUser()) && isValidContact(request.resource.data);
      allow update: if (isAdmin() || isApprovedUser()) && isValidContact(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
