rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PRIMITIVES & HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function emailVerified() { return request.auth.token.email_verified == true; }
    function getAuthEmail() { return request.auth.token.get('email', '').lower(); }

    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Super Admin: Explicitly whitelisted email
    function isSuperAdmin() {
      return isSignedIn() && emailVerified() && getAuthEmail() == 'yilongwang05@gmail.com';
    }

    // Role detection via trusted document lookup
    function getStoredUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getStoredUser().role == role)
      );
    }

    function isAdmin() { return hasRole('admin') || isSuperAdmin(); }
    function isManager() { return isAdmin() || hasRole('manager'); }
    function isOperator() { return isManager() || hasRole('operator'); }
    function isViewer() { return isOperator() || hasRole('viewer'); }

    function isApprovedUser() {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getStoredUser().approved == true)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    // 2. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['email', 'displayName', 'role', 'approved']) &&
               data.email is string && data.email.size() <= 128 &&
               data.displayName is string && data.displayName.size() <= 128 &&
               (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 512)) &&
               data.role in ['admin', 'manager', 'operator', 'viewer'] &&
               data.approved is bool;
      }

      allow get: if isValidId(userId) && (isOwner(userId) || isApprovedUser());
      allow list: if isApprovedUser();
      
      allow create: if isValidId(userId) && isOwner(userId) && 
                      isValidUser(incoming()) &&
                      // Self-registration defaults: unapproved viewer OR check invitation
                      (
                        (incoming().approved == false && incoming().role == 'viewer') || 
                        isAdmin() ||
                        (
                          exists(/databases/$(database)/documents/invitations/$(incoming().email.lower())) &&
                          get(/databases/$(database)/documents/invitations/$(incoming().email.lower())).data.role == incoming().role &&
                          get(/databases/$(database)/documents/invitations/$(incoming().email.lower())).data.approved == incoming().approved
                        )
                      );

      allow update: if isValidId(userId) && (
                      (isManager() && isValidUser(incoming())) ||
                      (isOwner(userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt', 'pushToken']) &&
                       incoming().email == existing().email &&
                       incoming().role == existing().role &&
                       incoming().approved == existing().approved &&
                       (!('pushToken' in incoming()) || incoming().pushToken == null ||
                        (incoming().pushToken is string && incoming().pushToken.size() <= 200)) &&
                       isValidUser(incoming()))
                    );
      allow delete: if isValidId(userId) && isAdmin();

      // Personal prayers — private to the owning user; never shared. Powers the
      // "Your prayers" personal list on My Day.
      match /personalPrayers/{prayerId} {
        allow read, write, delete: if isApprovedUser() && (isOwner(userId) || isManager());
      }
    }

    // 2b. User Preferences — private My Day settings (personal contacts,
    // messaging app) scoped to the owning user.
    match /userPreferences/{userId} {
      allow read, write: if isApprovedUser() && (isOwner(userId) || isManager());
    }

    // 3. Invitations Collection
    match /invitations/{email} {
      function isValidInvitation(data) {
        return data.keys().hasAll(['email', 'role', 'approved']) &&
               data.email is string && data.email.size() <= 128 &&
               data.role in ['admin', 'manager', 'operator', 'viewer'] &&
               data.approved is bool;
      }

      allow get: if isManager() || (isSignedIn() && getAuthEmail() == email.lower());
      allow list: if isManager();
      allow create, update: if isManager() && isValidInvitation(incoming());
      allow delete: if isManager() || (isSignedIn() && getAuthEmail() == email.lower());
    }

    // 4. Contacts Collection
    match /contacts/{contactId} {
      function isValidContact(data) {
        // Optional fields are guarded with `!('x' in data)` first: a partial
        // update (e.g. flipping only `reviewed`) produces a merged doc that may
        // omit an optional key, and `data.x == null` errors ("Property x is
        // undefined") on an absent key rather than returning false.
        return data.name is string && data.name.size() <= 128 &&
               data.email is string && data.email.size() <= 128 &&
               (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 32)) &&
               (!('role' in data) || data.role == null || (data.role is string && data.role.size() <= 64)) &&
               (!('location' in data) || data.location == null || (data.location is string && data.location.size() <= 128)) &&
               (!('stage' in data) || data.stage == null || (data.stage is string && data.stage.size() <= 64)) &&
               (!('reviewed' in data) || data.reviewed == null || data.reviewed is bool);
      }

      allow read: if isApprovedUser();
      // Anti-abuse Note: Without App Check or an authenticated backend function,
      // this allows unauthenticated creates. Mitigated partially by client-side 
      // honeypot and math captcha on the public form. Acceptable for low-traffic.
      allow create: if isValidId(contactId) && isValidContact(incoming());
      // Operators edit the typed profile fields; unknown keys are rejected
      // (ghost-field injection). diff().affectedKeys() only inspects the changed
      // keys, so a contact carrying legacy/extra fields stays editable as long as
      // the edit itself touches only known fields. Creation-audit fields
      // (createdAt/createdBy/createdByName/serverCreatedAt) are deliberately
      // omitted so updates cannot rewrite who/when a contact was created; the
      // updatedAt/updatedBy/updatedByName trio stays because the client stamps
      // them on every edit. The lastContactedBy/ById/Date trio is likewise
      // client-stamped whenever an interaction is logged (LogInteractionModal's
      // batch and ContactDetailsModal.handleAddInteraction).
      allow update: if isValidId(contactId) && isApprovedUser() && isOperator() &&
                      isValidContact(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly([
                        'name', 'initials', 'role', 'location', 'email', 'phone', 'stage',
                        'tags', 'notes', 'spiritualBackground', 'pronouns', 'year', 'major',
                        'instagram', 'howHeard', 'interests', 'prayerRequest', 'attendance',
                        'lastSeen', 'avatar', 'hasNewActivity', 'reviewed',
                        'lastContactedBy', 'lastContactedById', 'lastContactedDate',
                        'updatedAt', 'updatedBy', 'updatedByName'
                      ]);
      allow delete: if isValidId(contactId) && isManager();

      // Interactions
      match /interactions/{interactionId} {
        function isValidInteraction(data) {
          return data.keys().hasAll(['userId', 'userName', 'content', 'dateTime', 'createdAt']) &&
                 data.userName is string && data.userName.size() <= 128 &&
                 data.content is string && data.content.size() <= 5000;
        }

        allow list: if isApprovedUser();
        allow get: if isValidId(interactionId) && isApprovedUser();
        allow create: if isValidId(interactionId) && isApprovedUser() && isOperator() && 
                        isValidInteraction(incoming()) && 
                        incoming().userId == request.auth.uid && 
                        incoming().createdAt == request.time;
        allow update: if isValidId(interactionId) && isApprovedUser() && isOperator() && 
                        isValidInteraction(incoming()) && 
                        incoming().userId == existing().userId &&
                        (existing().userId == request.auth.uid || isAdmin()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['content', 'dateTime', 'type', 'userName', 'userPhoto']);
        allow delete: if isValidId(interactionId) && isApprovedUser() && (isManager() || existing().userId == request.auth.uid);
      }

      // Comments
      match /comments/{commentId} {
        function isValidComment(data) {
          return data.keys().hasAll(['userId', 'userName', 'text', 'createdAt']) &&
                 data.userName is string && data.userName.size() <= 128 &&
                 data.text is string && data.text.size() <= 2000 &&
                 (data.parentId == null || (data.parentId is string && data.parentId.size() <= 128));
        }

        allow read: if isApprovedUser();
        allow create: if isValidId(commentId) && isApprovedUser() && isOperator() && 
                        isValidComment(incoming()) && 
                        incoming().userId == request.auth.uid && 
                        incoming().createdAt == request.time;
        allow update: if isValidId(commentId) && isApprovedUser() && isOperator() && 
                        isValidComment(incoming()) && 
                        incoming().userId == existing().userId &&
                        (existing().userId == request.auth.uid || isAdmin()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['text']);
        allow delete: if isValidId(commentId) && isApprovedUser() && (isManager() || existing().userId == request.auth.uid);
      }

      // Walking-together threads (trainee <-> full-timer). A light conversation
      // attached to the contact (interactionId null) or to one interaction.
      match /threads/{threadId} {
        function isValidThread(data) {
          return data.keys().hasAll(['from', 'fromName', 'kind', 'body', 'at', 'reactions', 'interactionId']) &&
                 data.from is string && data.from.size() <= 128 &&
                 data.fromName is string && data.fromName.size() <= 128 &&
                 data.kind in ['note', 'question', 'comment', 'encouragement', 'nudge'] &&
                 data.body is string && data.body.size() > 0 && data.body.size() <= 5000 &&
                 data.at is string && data.at.size() <= 40 &&
                 data.reactions is list &&
                 (data.interactionId == null || (data.interactionId is string && data.interactionId.size() <= 128));
        }

        allow read: if isApprovedUser();
        allow create: if isValidId(threadId) && isApprovedUser() && isOperator() &&
                        isValidThread(incoming()) &&
                        incoming().from == request.auth.uid &&
                        incoming().reactions.size() == 0;
        // Reactions: any approved operator may toggle the reactions array.
        // Body edits: author only (kind/from/at are immutable).
        allow update: if isValidId(threadId) && isApprovedUser() && isOperator() && (
                        incoming().diff(existing()).affectedKeys().hasOnly(['reactions'])
                        || (
                          incoming().diff(existing()).affectedKeys().hasOnly(['body']) &&
                          existing().from == request.auth.uid &&
                          incoming().body is string && incoming().body.size() > 0 && incoming().body.size() <= 5000
                        )
                      );
        allow delete: if isValidId(threadId) && isApprovedUser() && (isManager() || existing().from == request.auth.uid);
      }
    }

    // 5. Stages Collection
    match /stages/{stageId} {
      function isValidStage(data) {
        return data.keys().hasAll(['label', 'color', 'order']) &&
               data.label is string && data.label.size() <= 64 &&
               data.color is string && data.color.size() <= 64 &&
               data.order is int;
      }

      allow read: if true;
      allow create, update, delete: if isValidId(stageId) && isManager() && (request.method != 'DELETE' ? isValidStage(incoming()) : true);
    }

    // 6. Events Collection
    match /events/{eventId} {
      function isValidEvent(data) {
        return data.keys().hasAll(['name', 'date', 'order']) &&
               data.name is string && data.name.size() <= 128 &&
               data.date is string && data.date.size() <= 64 &&
               data.order is int;
      }

      allow read: if isApprovedUser();
      allow create, update: if isValidId(eventId) && isOperator() && isValidEvent(incoming());
      allow delete: if isValidId(eventId) && isManager();

      // RSVPs — one doc per attendee, keyed by uid. Any approved user may read
      // (staff see who's coming); a user may only create/delete their own.
      match /rsvps/{uid} {
        allow read: if isApprovedUser();
        allow create, delete: if isApprovedUser() && isOwner(uid);
      }
    }

    // 6b. Gathering Types — the managed "kinds of gathering" taxonomy (mirrors stages).
    match /gatheringTypes/{typeId} {
      function isValidGatheringType(data) {
        return data.keys().hasAll(['name', 'order']) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 64 &&
               (!('blurb' in data) || data.blurb == null || (data.blurb is string && data.blurb.size() <= 200)) &&
               data.order is int;
      }

      allow read: if isApprovedUser();
      allow create, update: if isValidId(typeId) && isManager() && isValidGatheringType(incoming());
      allow delete: if isValidId(typeId) && isManager();
    }

    // 6c. Settings — small team-wide singletons (e.g. settings/season). Publicly
    // readable so the public sign-up reflects the active season / club-rush; only
    // managers may change them.
    match /settings/{docId} {
      function isValidSeasonSettings(data) {
        return data.keys().hasOnly(['override', 'clubRush']) &&
               (!('override' in data) || data.override == null ||
                 (data.override is string && data.override.size() <= 32)) &&
               (!('clubRush' in data) || data.clubRush is bool);
      }

      allow read: if true;
      allow create, update: if docId == 'season' && isManager() && isValidSeasonSettings(incoming());
      allow delete: if false;
    }

    // 7. Activities Collection
    match /activities/{activityId} {
      function isValidActivity(data) {
        return data.userId == request.auth.uid &&
               data.userName is string && data.userName.size() <= 128 &&
               data.action is string && data.action.size() <= 256 &&
               data.targetType in ['contact', 'event', 'comment', 'interaction'] &&
               data.type in ['call', 'email', 'event', 'alert', 'edit', 'create', 'comment'];
      }
      allow list: if isSignedIn() && (isApprovedUser() || isSuperAdmin());
      allow get: if isApprovedUser();
      allow create: if isValidId(activityId) && isApprovedUser() && isOperator() && isValidActivity(incoming());
      allow update, delete: if isValidId(activityId) && isManager();
    }

    // 8. Notifications Collection
    match /notifications/{notificationId} {
      function isValidNotification(data) {
        return data.userId is string &&
               data.title is string && data.title.size() <= 128 &&
               data.message is string && data.message.size() <= 512 &&
               data.type in ['info', 'success', 'warning', 'error', 'assignment', 'event'] &&
               data.read is bool &&
               data.createdAt == request.time;
      }

      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isManager() || (resource.data.userId == 'ALL_ADMINS'));
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isManager() || (resource.data.userId == 'ALL_ADMINS'));
      
      allow create: if isValidId(notificationId) && isValidNotification(incoming()) && (
                      (isApprovedUser() && isOperator()) ||
                      (incoming().userId == 'ALL_ADMINS' && incoming().type == 'event')
                    );
      
      allow update: if isValidId(notificationId) && isSignedIn() && (
                      (resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readBy'])) ||
                      (resource.data.userId == 'ALL_ADMINS' && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readBy', 'dismissedBy'])) ||
                      isSuperAdmin() ||
                      isManager()
                    );
      
      allow delete: if isValidId(notificationId) && (isOwner(resource.data.userId) || isManager() || resource.data.userId == 'ALL_ADMINS');
    }

    // 9. Prayers Collection
    match /prayers/{prayerId} {
      function isValidPrayer(data) {
        return data.keys().hasAll(['contactId', 'updatedAt']) && isValidId(data.contactId) &&
               (!('date' in data) || (data.date is string && data.date.size() <= 64)) &&
               (!('burden' in data) || (data.burden is string && data.burden.size() <= 10000)) &&
               (!('answer' in data) || (data.answer is string && data.answer.size() <= 10000)) &&
               (!('answeredPhotos' in data) || (data.answeredPhotos is list && data.answeredPhotos.size() <= 4)) &&
               (!('status' in data) || data.status in ['pending', 'answered', 'ongoing', 'unanswered']) &&
               (!('prayedFor' in data) || (data.prayedFor is string && data.prayedFor.size() <= 10000)) &&
               (!('unanswered' in data) || (data.unanswered is string && data.unanswered.size() <= 10000)) &&
               (!('prayerPage' in data) || data.prayerPage is bool) &&
               // Whether the team carries this burden. Absent means the team's,
               // so this validates the shape only — surfacing is the app's call,
               // not an access boundary (every approved user still reads it).
               (!('teamPrayer' in data) || data.teamPrayer is bool) &&
               (!('updatedAt' in data) || data.updatedAt is string);
      }

      allow get: if isApprovedUser();
      allow list: if isApprovedUser();
      allow create, update: if isApprovedUser() && isOperator() && isValidPrayer(incoming());
      allow delete: if isManager();
    }

    // 9b. Prayer Requests — a Student or Community member asking the team to
    // pray for THEM (mobile v2's member app). Distinct from /prayers, which
    // hangs off a contactId: the asker is a user account, not a contact. The
    // asker owns their rows; staff (manager and up) read every row, which is
    // how the ask reaches the Full-timer home's "Prayers to carry".
    match /prayerRequests/{requestId} {
      function isValidPrayerRequest(data) {
        return data.keys().hasAll(['uid', 'name', 'body', 'status', 'createdAt', 'updatedAt']) &&
               isValidId(data.uid) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
               data.body is string && data.body.size() > 0 && data.body.size() <= 5000 &&
               data.status in ['open', 'answered'] &&
               data.createdAt is string && data.createdAt.size() <= 64 &&
               data.updatedAt is string && data.updatedAt.size() <= 64;
      }

      allow get: if isApprovedUser() && (isOwner(existing().uid) || isManager());
      // The member's own list filters on uid; the staff list filters on status.
      // Both are approved-user reads — a member listing everyone's requests is
      // the one thing this opens up, and these are asks meant for the team.
      allow list: if isApprovedUser();
      allow create: if isApprovedUser() && isOwner(incoming().uid) && isValidPrayerRequest(incoming());
      // "God answered this" is the asker's to say; staff can close one out too.
      allow update: if isApprovedUser() && (isOwner(existing().uid) || isManager()) &&
                      isValidPrayerRequest(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(existing().uid) || isManager();
    }

    // 9c. Hospitality Offers — a Community member's standing offer to host
    // students at their table (mobile v2's "Open your home"). Doc id IS the
    // uid, so one household has one offer.
    match /hospitalityOffers/{userId} {
      function isValidOffer(data) {
        return data.keys().hasAll(['uid', 'name', 'availability', 'seats', 'note', 'updatedAt']) &&
               data.uid == userId &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
               data.availability is list && data.availability.size() <= 8 &&
               data.seats is string && data.seats.size() <= 128 &&
               data.note is string && data.note.size() <= 2000 &&
               data.updatedAt is string && data.updatedAt.size() <= 64;
      }

      allow get: if isApprovedUser() && (isOwner(userId) || isManager());
      // Staff list every open home; a member only ever reads their own doc by
      // id, so the list rule is staff-only.
      allow list: if isManager();
      allow create, update: if isApprovedUser() && isOwner(userId) && isValidOffer(incoming());
      allow delete: if isOwner(userId) || isManager();
    }

    // 10. Tasks Collection
    match /tasks/{taskId} {
      function isValidTask(data) {
        return data.title is string && data.title.size() <= 500 &&
               (data.get('dueDate', null) == null || (data.get('dueDate', null) is string && data.get('dueDate', null).size() <= 20)) &&
               data.status in ['pending', 'completed', 'canceled'] &&
               data.priority in ['low', 'medium', 'high'] &&
               (data.get('contactId', null) == null || (data.get('contactId', null) is string && data.get('contactId', null).size() <= 128)) &&
               (data.get('contactName', null) == null || (data.get('contactName', null) is string && data.get('contactName', null).size() <= 128)) &&
               (data.get('assigneeId', null) == null || (data.get('assigneeId', null) is string && data.get('assigneeId', null).size() <= 128)) &&
               (data.get('sourceInteractionId', null) == null || (data.get('sourceInteractionId', null) is string && data.get('sourceInteractionId', null).size() <= 128)) &&
               (data.get('createdById', null) == null || (data.get('createdById', null) is string && data.get('createdById', null).size() <= 128)) &&
               (data.get('createdByName', null) == null || (data.get('createdByName', null) is string && data.get('createdByName', null).size() <= 128)) &&
               (data.get('sourceDocId', null) == null || (data.get('sourceDocId', null) is string && data.get('sourceDocId', null).size() <= 128)) &&
               (data.get('sourceDocTitle', null) == null || (data.get('sourceDocTitle', null) is string && data.get('sourceDocTitle', null).size() <= 256));
      }
      allow list, get: if isApprovedUser();
      allow create, update: if isApprovedUser() && isOperator() && isValidTask(incoming());
      allow delete: if isManager() || isSuperAdmin();
    }

    // 10a. Outreach — monthly park outings. Full-timers + the community folk
    // who go out (they log the names; full-timers oversee). Trainees and
    // students don't see it. The record's NAMES are the point: logging creates
    // the contacts (open to any approved user) alongside, via the contacts
    // rules; the follow-up to-dos ride the tasks rules (operator+, so a
    // community logger's names just don't get auto-to-dos).
    match /outreach/{outreachId} {
      function isValidOutreach(data) {
        return data.date is string && data.date.size() <= 20 &&
               data.where is string && data.where.size() <= 300 &&
               data.went is list &&
               data.others is int && data.others >= 0 &&
               data.handed is map &&
               data.how is string &&
               data.photoCount is int && data.photoCount >= 0 &&
               data.names is list;
      }
      allow list, get: if isAdmin() || hasRole('viewer');
      allow create: if (isAdmin() || hasRole('viewer')) && isValidOutreach(incoming());
      allow update: if isAdmin() && isValidOutreach(incoming());
      allow delete: if isAdmin();
    }
    // 10b. Visits Collection — a record of having gone to where someone lives.
    // Full-timers only, on both sides: what's written in a visit ("she's been
    // quiet since her dad's surgery") is pastoral detail that shouldn't be a
    // team-wide read. The photos live in Cloud Storage; only their metadata is
    // here. Optional keys use the `!('x' in data)` guard for the same reason
    // isValidContact does — a partial update merges to a doc that may omit them.
    match /visits/{visitId} {
      function isValidVisit(data) {
        return data.keys().hasAll(['date', 'contactIds', 'went']) &&
               data.date is string && data.date.size() <= 20 &&
               data.contactIds is list && data.contactIds.size() > 0 && data.contactIds.size() <= 20 &&
               data.went is list && data.went.size() <= 20 &&
               (!('contactNames' in data) || data.contactNames is list) &&
               (!('wentNames' in data) || data.wentNames is list) &&
               (!('where' in data) || data.where == null || (data.where is string && data.where.size() <= 200)) &&
               (!('purpose' in data) || data.purpose == null || (data.purpose is string && data.purpose.size() <= 500)) &&
               (!('how' in data) || data.how == null || (data.how is string && data.how.size() <= 5000)) &&
               (!('followUp' in data) || data.followUp == null || (data.followUp is string && data.followUp.size() <= 500)) &&
               (!('followUpTaskId' in data) || data.followUpTaskId == null || (data.followUpTaskId is string && data.followUpTaskId.size() <= 128)) &&
               (!('prayerId' in data) || data.prayerId == null || (data.prayerId is string && data.prayerId.size() <= 128)) &&
               (!('prayerBurden' in data) || data.prayerBurden == null || (data.prayerBurden is string && data.prayerBurden.size() <= 500)) &&
               (!('photos' in data) || data.photos is list && data.photos.size() <= 12);
      }

      allow list, get: if isApprovedUser() && isAdmin();
      allow create, update: if isValidId(visitId) && isApprovedUser() && isAdmin() && isValidVisit(incoming());
      allow delete: if isValidId(visitId) && isAdmin();
    }

    // 11. Feedback Collection
    match /feedback/{feedbackId} {
      function isValidFeedback(data) {
        return data.keys().hasAll(['userId', 'userEmail', 'type', 'message', 'status', 'createdAt']) &&
               data.userId == request.auth.uid &&
               data.userEmail is string && data.userEmail.size() <= 128 &&
               data.type in ['bug', 'enhancement'] &&
               (!('kind' in data) || data.kind in ['thought', 'idea', 'off', 'request']) &&
               data.message is string && data.message.size() <= 5000 &&
               data.status in ['new', 'in_progress', 'resolved'] &&
               data.createdAt == request.time &&
               (!('githubIssueUrl' in data) || (data.githubIssueUrl is string && data.githubIssueUrl.size() <= 1000)) &&
               (!('url' in data) || (data.url is string && data.url.size() <= 2000)) &&
               (!('screenshot' in data) || (data.screenshot is string && data.screenshot.size() <= 200000)) &&
               (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 1000)) &&
               (!('viewport' in data) || (data.viewport is string && data.viewport.size() <= 100)) &&
               (!('archived' in data) || data.archived is bool);
      }

      allow list, get: if isAdmin();
      allow create: if isValidId(feedbackId) && isApprovedUser() && isValidFeedback(incoming());
      allow update: if isValidId(feedbackId) && isAdmin() &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'githubIssueUrl', 'archived']) &&
                      incoming().status in ['new', 'in_progress', 'resolved'] &&
                      (!('githubIssueUrl' in incoming()) || (incoming().githubIssueUrl is string && incoming().githubIssueUrl.size() <= 1000 || incoming().githubIssueUrl == null)) &&
                      (!('archived' in incoming()) || incoming().archived is bool);
      allow delete: if isValidId(feedbackId) && isAdmin();
    }

    // 12. Webhook Logs Collection
    match /webhook_logs/{logId} {
      allow get, delete: if isValidId(logId) && isManager();
      allow list: if isManager();
    }

    // 13. Coordination Notes Collection
    match /coordination_notes/{noteId} {
      function isValidCoordinationNote(data) {
        return data.keys().hasAll(['title', 'date', 'content', 'category', 'todos']) &&
               data.title is string && data.title.size() <= 200 &&
               data.date is string && data.date.size() <= 64 &&
               data.content is string && data.content.size() <= 100000 &&
               data.category is string && data.category.size() <= 64 &&
               data.todos is list &&
               (!('archived' in data) || data.archived is bool);
      }

      allow get, list: if isAdmin();
      allow create: if isValidId(noteId) && isAdmin() && isValidCoordinationNote(incoming());
      allow update: if isValidId(noteId) && isAdmin() && isValidCoordinationNote(incoming());
      allow delete: if isValidId(noteId) && isAdmin();
    }

    // 14. The Board — coordination sessions (agenda + delegated tasks embedded)
    match /board_sessions/{sessionId} {
      function isValidBoardSession(data) {
        return data.keys().hasAll(['event', 'date', 'time', 'place', 'agenda', 'assigned']) &&
               data.event is string && data.event.size() <= 200 &&
               data.date is string && data.date.size() <= 64 &&
               data.time is string && data.time.size() <= 64 &&
               data.place is string && data.place.size() <= 200 &&
               data.agenda is list && data.agenda.size() <= 200 &&
               data.assigned is list && data.assigned.size() <= 200 &&
               (!('facilitatorId' in data) || (data.facilitatorId is string && data.facilitatorId.size() <= 128));
      }

      allow get, list: if isAdmin();
      allow create: if isValidId(sessionId) && isAdmin() && isValidBoardSession(incoming());
      allow update: if isValidId(sessionId) && isAdmin() && isValidBoardSession(incoming());
      allow delete: if isValidId(sessionId) && isAdmin();
    }

    // 15. The Board — notes & learnings archive
    match /board_notes/{noteId} {
      function isValidBoardNote(data) {
        return data.keys().hasAll(['type', 'series', 'title', 'body', 'date', 'contributorIds', 'tags']) &&
               data.type in ['record', 'learning'] &&
               data.series is string && data.series.size() <= 120 &&
               data.title is string && data.title.size() <= 200 &&
               data.body is string && data.body.size() <= 20000 &&
               data.date is string && data.date.size() <= 64 &&
               data.contributorIds is list && data.contributorIds.size() <= 50 &&
               data.tags is list && data.tags.size() <= 50 &&
               (!('sessionId' in data) || (data.sessionId is string && data.sessionId.size() <= 128));
      }

      // Read: Full-timers + Trainees (the shared archive). Write: Full-timers.
      allow get, list: if isManager();
      allow create: if isValidId(noteId) && isAdmin() && isValidBoardNote(incoming());
      allow update: if isValidId(noteId) && isAdmin() && isValidBoardNote(incoming());
      allow delete: if isValidId(noteId) && isAdmin();
    }

    // 16. The Board — dated Markdown pages (one running doc per gathering)
    match /board_docs/{docId} {
      function isValidBoardDoc(data) {
        return data.keys().hasAll(['date', 'title', 'md']) &&
               data.date is string && data.date.size() <= 64 &&
               data.title is string && data.title.size() <= 200 &&
               data.md is string && data.md.size() <= 100000 &&
               (!('facilitatorId' in data) || (data.facilitatorId is string && data.facilitatorId.size() <= 128)) &&
               (!('place' in data) || (data.place is string && data.place.size() <= 200)) &&
               (!('time' in data) || (data.time is string && data.time.size() <= 64)) &&
               (!('audience' in data) || data.audience in ['team', 'trainees', 'everyone']);
      }

      // Read by audience: Full-timers see all (incl. legacy pages with no
      // audience); Trainees see 'trainees' + 'everyone'; Students see 'everyone'.
      // Non-admins must scope their query by audience so each returned doc passes.
      allow get, list: if isAdmin()
                          || ('audience' in existing() && existing().audience == 'everyone' && isOperator())
                          || ('audience' in existing() && existing().audience == 'trainees' && isManager());
      allow create: if isValidId(docId) && isAdmin() && isValidBoardDoc(incoming());
      allow update: if isValidId(docId) && isAdmin() && isValidBoardDoc(incoming());
      allow delete: if isValidId(docId) && isAdmin();
    }

    // 17. Private Group & Direct Messaging
    match /chatRooms/{roomId} {
      function isRoomMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }

      // An announcement room is one everybody in it reads but only Full-timers
      // post to (mobile v2's member "Announcements"). Mirrored client-side by
      // canPostToRoom() in packages/core/src/chat.ts.
      function isAnnouncementRoom(roomData) {
        return roomData.get('type', 'group') == 'announcement';
      }

      // Only room members can view chats.
      allow read: if isSignedIn() && isRoomMember();

      // Create room: creator must be in the memberIds array and matches auth
      // user. Only a Full-timer may open an announcement room.
      allow create: if isSignedIn() &&
                    request.resource.data.createdById == request.auth.uid &&
                    request.auth.uid in request.resource.data.memberIds &&
                    (!isAnnouncementRoom(incoming()) || isAdmin());

      // Update room: Admins can update any room. Members can update their
      // rooms — but only a Full-timer may change what KIND of room it is, or a
      // member could flip an announcement to a group and post into it.
      allow update: if isSignedIn() && (isRoomMember() || isAdmin()) &&
                    (isAdmin() || incoming().get('type', 'group') == existing().get('type', 'group'));
      allow delete: if isSignedIn() && (isAdmin() || (resource.data.createdById == request.auth.uid));

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberIds.hasAny([request.auth.uid]);

        // In an announcement room only Full-timers post; everyone else reads.
        // The parent room is already fetched for the membership check, so the
        // type check costs no extra document read.
        allow create: if isSignedIn() &&
                      get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberIds.hasAny([request.auth.uid]) &&
                      (isAdmin() || !isAnnouncementRoom(get(/databases/$(database)/documents/chatRooms/$(roomId)).data)) &&
                      request.resource.data.senderId == request.auth.uid;

        // A sent message is otherwise immutable — but two distinct field-level
        // acts are allowed, matching the Field Notes design (views/messages.jsx),
        // and never in the same write:
        //   • reactions / pinned — anyone in the room can add or take back
        //     their own reaction and pin/unpin, on a LIVE message only
        //   • deleted — a tombstone for "take back for everyone"; only the
        //     author or a Full-timer may leave it, once set it stays (a
        //     conversation never silently rewrites itself), and a gone message
        //     can't be reacted to or pinned
        // `isRoomMember()` can't be reused here: inside this nested match
        // `resource` is the message, so membership is looked up on the parent
        // room like the read/create rules do.
        allow update: if isSignedIn() &&
                      get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberIds.hasAny([request.auth.uid]) &&
                      (
                        // leaving a tombstone — the author's or a Full-timer's
                        // act, and ONLY the `deleted` field may change
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted']) &&
                         resource.data.deleted == null && request.resource.data.deleted != null &&
                         (request.auth.uid == resource.data.senderId || isAdmin())) ||
                        // a plain reaction / pin toggle on a live message —
                        // the message must stay undeleted and untouched
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pinned']) &&
                         resource.data.deleted == null && request.resource.data.deleted == null)
                      );
        allow delete: if false; // A tombstone replaces deletion
      }
    }

    // Collection Group helpers
    match /{path=**}/interactions/{interactionId} {
      allow list: if isApprovedUser();
    }
    match /{path=**}/comments/{commentId} {
      allow list: if isApprovedUser();
    }
    // Walking-together threads — collection-group list for the full-timer inbox
    // (My Day) and the trainee cockpit, which read thread messages across all
    // contacts at once. The nested contacts/{id}/threads rule governs get/write.
    match /{path=**}/threads/{threadId} {
      allow list: if isApprovedUser();
    }
    // RSVPs — collection-group query for "events I'm going to" (subscribeMyRsvps).
    // Scoped to the requester's own RSVPs: the query filters on the `uid` field,
    // so listing other people's RSVPs across events is denied. (Staff still read
    // a single event's RSVP list via the nested events/{id}/rsvps read rule.)
    match /{path=**}/rsvps/{rsvpId} {
      allow list: if isApprovedUser() && (resource.data.uid == request.auth.uid || isManager());
    }
  }
}
