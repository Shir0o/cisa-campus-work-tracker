rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'yilongwang05@gmail.com'
      );
    }

    function isApprovedUser() {
      // In rules, we can't easily check another doc's field without potentially triggering recursive lookups
      // but get() is fine if carefully used. For now, we'll allow admin or verified owner.
      return isSignedIn() && (
        request.auth.token.email == 'yilongwang05@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Admins must be provisioned manually or via secure process
    }

    // 2. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && 
                      request.resource.data.keys().hasAll(['email', 'displayName', 'photoURL', 'approved']) &&
                      (request.resource.data.approved == false || request.auth.token.email == 'yilongwang05@gmail.com');
      allow update: if (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'approved'])) &&
                      (isAdmin() || (isOwner(userId) && request.resource.data.approved == resource.data.approved));
    }

    // 3. Contacts Collection
    match /contacts/{contactId} {
      function isValidContact(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 100;
      }

      allow read: if isAdmin() || isApprovedUser();
      allow create: if (isAdmin() || isApprovedUser()) && isValidContact(request.resource.data);
      allow update: if (isAdmin() || isApprovedUser()) && isValidContact(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
