rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getAuthEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function isSuperAdmin() {
      return isSignedIn() && 
             request.auth.token.get('email', '').lower() == 'yilongwang05@gmail.com';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role)
      );
    }

    function isAdmin() { return hasRole('admin'); }
    function isManager() { return isAdmin() || hasRole('manager'); }
    function isOperator() { return isManager() || hasRole('operator') || isSuperAdmin(); }
    function isViewer() { return isOperator() || hasRole('viewer') || isSuperAdmin(); }

    function isApprovedUser() {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().approved == true)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidEmailId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // 2. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.email is string && data.email.size() <= 100 &&
               data.displayName is string && data.displayName.size() <= 100 &&
               (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 512)) &&
               data.approved is bool &&
               (data.role in ['admin', 'manager', 'operator', 'viewer']);
      }

      allow get: if isValidId(userId) && (isOwner(userId) || isManager());
      allow list: if isManager();
      allow create: if isValidId(userId) && isOwner(userId) && 
                      request.resource.data.keys().hasAll(['email', 'displayName', 'photoURL', 'approved', 'role', 'createdAt', 'updatedAt']) &&
                      isValidUser(request.resource.data) &&
                      (
                        (request.resource.data.approved == false && request.resource.data.role == 'viewer') || 
                        isAdmin() ||
                        (
                          exists(/databases/$(database)/documents/invitations/$(request.resource.data.email.lower())) &&
                          get(/databases/$(database)/documents/invitations/$(request.resource.data.email.lower())).data.role == request.resource.data.role &&
                          get(/databases/$(database)/documents/invitations/$(request.resource.data.email.lower())).data.approved == request.resource.data.approved
                        )
                      );
      allow update: if isValidId(userId) && (
                      (isManager() && isValidUser(request.resource.data)) || 
                      (isOwner(userId) && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']) &&
                       request.resource.data.email == resource.data.email &&
                       request.resource.data.role == resource.data.role &&
                       request.resource.data.approved == resource.data.approved &&
                       isValidUser(request.resource.data))
                    );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 3. Invitations Collection
    match /invitations/{email} {
      function isValidInvitation(data) {
        return data.email is string &&
               (data.role in ['admin', 'manager', 'operator', 'viewer']) &&
               data.approved is bool;
      }

      allow get: if isValidEmailId(email) && (isManager() || (isSignedIn() && getAuthEmail() == email.lower()));
      allow list: if isManager();
      allow create: if (isSuperAdmin() || isManager()) && isValidInvitation(request.resource.data);
      allow update: if (isSuperAdmin() || isManager()) && isValidInvitation(request.resource.data);
      allow delete: if (isSuperAdmin() || isManager());
    }

    // 4. Contacts Collection
    match /contacts/{contactId} {
      function isValidContact(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 100;
      }

      allow read: if isApprovedUser();
      allow create: if isApprovedUser() && isOperator() && isValidContact(request.resource.data);
      allow update: if isApprovedUser() && isOperator() && isValidContact(request.resource.data);
      allow delete: if isAdmin() || isManager();

      // Interactions subcollection
      match /interactions/{interactionId} {
        function isValidInteraction(data) {
          return data.userId == request.auth.uid &&
                 data.userName is string && data.userName.size() <= 100 &&
                 data.content is string && data.content.size() <= 5000 &&
                 data.dateTime is string &&
                 data.createdAt == request.time;
        }

        // Allow list only if they are approved and authenticated correctly
        allow list: if isApprovedUser();
        allow get: if isApprovedUser();
        allow create: if isApprovedUser() && isOperator() && isValidInteraction(request.resource.data);
        allow update: if isApprovedUser() && isOperator() && isValidInteraction(request.resource.data) && request.resource.data.userId == resource.data.userId;
        allow delete: if isApprovedUser() && (isManager() || (resource.data.userId == request.auth.uid));
      }

      // Comments subcollection
      match /comments/{commentId} {
        function isValidComment(data) {
          return data.userId == request.auth.uid &&
                 data.userName is string && data.userName.size() <= 100 &&
                 data.text is string && data.text.size() <= 1000 &&
                 data.createdAt == request.time;
        }

        allow read: if isApprovedUser();
        allow create: if isApprovedUser() && isOperator() && isValidComment(request.resource.data);
        allow update: if isApprovedUser() && isOperator() && isValidComment(request.resource.data) && request.resource.data.userId == resource.data.userId;
        allow delete: if isApprovedUser() && (isManager() || (resource.data.userId == request.auth.uid));
      }
    }

    // 5. Stages Collection
    match /stages/{stageId} {
      function isValidStage(data) {
        return data.label is string && data.label.size() <= 64 &&
               data.color is string && data.color.size() <= 64 &&
               data.order is int;
      }

      allow read: if isApprovedUser();
      allow create: if isManager() && isValidId(stageId) && isValidStage(request.resource.data);
      allow update: if isManager() && isValidId(stageId) && isValidStage(request.resource.data);
      allow delete: if isManager() && isValidId(stageId);
    }

    // 6. Events Collection
    match /events/{eventId} {
      function isValidEvent(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.date is string && data.date.size() <= 64 &&
               data.order is int;
      }

      allow read: if isApprovedUser();
      allow create: if isOperator() && isValidEvent(request.resource.data);
      allow update: if isOperator() && isValidEvent(request.resource.data);
      allow delete: if isManager();
    }
  }
}
