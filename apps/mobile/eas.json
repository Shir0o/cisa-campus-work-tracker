{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cisa-campus-work-traker.pages.dev"
      }
    },
    "qa": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_FIREBASE_FIRESTORE_DB_ID": "qa-db",
        "EXPO_PUBLIC_API_URL": "https://cisa-campus-work-traker-qa.pages.dev"
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cisa-campus-work-traker.pages.dev"
      }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cisa-campus-work-traker.pages.dev"
      }
    }
  },
  "submit": {
    "production": {},
    "qa": {}
  }
}
