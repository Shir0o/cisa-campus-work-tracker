# Firebase config for the mobile app. Copy to `.env` and fill in the API key.
# These mirror the web app's Vite vars (VITE_* → EXPO_PUBLIC_*). Everything but
# the API key falls back to the shared static config in src/lib/firebase.ts.

EXPO_PUBLIC_FIREBASE_API_KEY=
# Optional overrides (defaults come from firebase-applet-config.json values):
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=sac-campus-hub.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=sac-campus-hub
# EXPO_PUBLIC_FIREBASE_APP_ID=1:914549253362:web:8a1b1aeca702d3ba0f1c6b
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=sac-campus-hub.firebasestorage.app
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=914549253362
# EXPO_PUBLIC_FIREBASE_FIRESTORE_DB_ID=ai-studio-43298cca-4d70-4c5d-bada-c10ab66ab897
# The Board's live collab editor needs RTDB — set this to enable it:
# EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# Base URL of the web app's own deployment, used to host the Coordination
# Notes WebView editor spike (see MIGRATION.md "Phase 0.5"). Defaults to
# localhost:3000 (the iOS Simulator can reach the Mac's loopback directly) —
# only needed if pointing at a deployed URL instead.
# EXPO_PUBLIC_WEB_APP_URL=http://localhost:3000
