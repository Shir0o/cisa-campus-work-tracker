{
  "expo": {
    "name": "CISA Campus Work Tracker",
    "slug": "cisa-campus",
    "scheme": "cisacampus",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#eaeef4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cisa.campus",
      "buildNumber": "2",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cisa.campus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#5c5595"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon-foreground.png",
          "color": "#5c5595"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon-foreground.png",
          "resizeMode": "contain",
          "backgroundColor": "#eaeef4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "twang26",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "17af80aa-7612-4442-ba7a-8332dbb466b9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/17af80aa-7612-4442-ba7a-8332dbb466b9"
    }
  }
}
