{
  "expo": {
    "name": "CISA Campus Work Tracker",
    "slug": "cisa-campus",
    "scheme": "cisacampus",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#eaeef4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cisa.campus"
    },
    "android": {
      "package": "com.cisa.campus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#5c5595"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon-foreground.png",
          "resizeMode": "contain",
          "backgroundColor": "#eaeef4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
