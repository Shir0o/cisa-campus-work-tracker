node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# E2E test user credentials (real Firebase email/password logins) — never commit
.test-credentials.json
**/.test-credentials.json
e2e/.auth/
playwright-report/
test-results/

# AI coding-assistant session state & pack outputs — never commit
.deepcode/
.aider*
.playwright-mcp/
repomix-output.xml
design-spec.xml

# Google service account keys (contain private keys) & EAS credentials dump — never commit
sac-*.json
*service-account*.json
*service_account*.json
credentials.json
# The files credentials.json points at (keystore, .p12, .mobileprovision).
# apps/mobile/.gitignore's ios/ and android/ rules happen to cover these
# today, but by accident - this rule is the one that means it.
apps/mobile/credentials/

# Play changelogs are compiled per release from content/whats-new/ at build
# time; the authored source is the manifest, not these.
apps/mobile/fastlane/metadata/

# local scratch / capture harnesses — never commit
tmp/

.worktrees/

# Design canvas payloads are generated from the .dc.html sources beside them
docs/design/**/[a-z]*-*.html

# impeccable design-hook cache (local only)
.impeccable/hook.cache.json

# Store signing material materialized from secrets at build time - never commit
*.p8
*.p12
*.mobileprovision
