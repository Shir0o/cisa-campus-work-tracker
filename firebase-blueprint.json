{
  "entities": {
    "contacts": {
      "title": "Contact",
      "description": "A person involved in an outreach campaign.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "location": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "stage": { 
          "type": "string"
        },
        "lastSeen": { "type": "string" },
        "avatar": { "type": "string" },
        "initials": { "type": "string" },
        "attendance": { "type": "object" },
        "approved": { "type": "boolean" },
        "spiritualBackground": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "email", "stage"]
    },
    "admins": {
      "title": "Admin",
      "description": "A user with administrative privileges.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["email"]
    },
    "users": {
        "title": "User",
        "description": "An authenticated user of the system.",
        "type": "object",
        "properties": {
            "email": { "type": "string" },
            "displayName": { "type": "string" },
            "photoURL": { "type": "string" },
            "approved": { "type": "boolean" },
            "role": { 
              "type": "string",
              "enum": ["admin", "manager", "operator", "viewer"]
            }
        },
        "required": ["email"]
    },
    "invitations": {
      "title": "Invitation",
      "description": "A pre-approved role and access assigned to an email.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "manager", "operator", "viewer"] },
        "approved": { "type": "boolean" },
        "invitedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "approved"]
    },
    "stages": {
      "title": "Stage",
      "description": "A workflow stage in the kanban board.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "color": { "type": "string" },
        "order": { "type": "integer" }
      },
      "required": ["label", "color", "order"]
    },
    "events": {
      "title": "Event",
      "description": "An outreach event for tracking attendance.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "date": { "type": "string" },
        "order": { "type": "integer" },
        "isRecurring": { "type": "boolean" },
        "recurrenceType": { "type": "string", "enum": ["none", "daily", "weekly", "monthly"] },
        "recurrenceCount": { "type": "integer" },
        "recurrenceEndDate": { "type": "string", "format": "date" },
        "recurrenceDays": { "type": "array", "items": { "type": "integer" } },
        "monthlyType": { "type": "string", "enum": ["same-day", "relative-day"] },
        "parentEventId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "date", "order"]
    },
    "interactions": {
      "title": "Interaction",
      "description": "A log of an interaction with a contact.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "content": { "type": "string" },
        "dateTime": { "type": "string", "format": "date-time" },
        "duration": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "content", "dateTime", "createdAt"]
    },
    "comments": {
      "title": "Comment",
      "description": "A message left on a contact record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "text": { "type": "string" },
        "parentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "text", "createdAt"]
    },
    "prayers": {
      "title": "Prayer Record",
      "description": "A log of prayer burdens and answers for a contact on a specific date.",
      "type": "object",
      "properties": {
        "contactId": { "type": "string" },
        "date": { "type": "string" },
        "burden": { "type": "string" },
        "answer": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" },
        "updatedByName": { "type": "string" }
      },
      "required": ["contactId", "date", "updatedAt"]
    },
    "activities": {
      "title": "Activity",
      "description": "A summary log of significant events in the system.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "targetType": { "type": "string", "enum": ["contact", "event", "comment", "interaction"] },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["call", "email", "event", "alert", "edit", "create", "comment"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "action", "targetId", "targetType", "type", "createdAt"]
    },
    "notifications": {
      "title": "Notification",
      "description": "A live alert for a specific user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error", "assignment", "event"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "link": { "type": "string" },
        "targetId": { "type": "string" }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt"]
    },
    "tasks": {
      "title": "Task",
      "description": "A follow-up task related to a contact.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "dueDate": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "contactId": { "type": "string" },
        "contactName": { "type": "string" },
        "assigneeId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "sourceInteractionId": { "type": "string" }
      },
      "required": ["title", "priority", "contactId", "status", "createdAt"]
    },
    "feedback": {
      "title": "Feedback",
      "description": "User feedback containing bug reports or enhancement needs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["bug", "enhancement"] },
        "kind": { "type": "string", "enum": ["thought", "idea", "off", "request"] },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "in_progress", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "githubIssueUrl": { "type": "string" }
      },
      "required": ["userId", "userEmail", "type", "message", "status", "createdAt"]
    },
    "webhook_logs": {
      "title": "Webhook Log",
      "description": "Incoming API and webhook logs for debugging purposes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "source": { "type": "string" },
        "payload": { "type": "string" },
        "headers": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "error", "ignored"] },
        "result": { "type": "string" },
        "error": { "type": "string" }
      },
      "required": ["id", "timestamp", "source", "payload", "headers", "status", "result"]
    },
    "coordination_notes": {
      "title": "Coordination Note",
      "description": "Meeting coordination note containing rich content (markdown), learnings, regular event category, and nested todo tasks.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "todos": {
          "type": "array",
          "items": { "type": "object" }
        },
        "archived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" },
        "updatedByName": { "type": "string" }
      },
      "required": ["title", "date", "content", "category", "todos"]
    }
  },
  "firestore": {
    "contacts/{contactId}": {
      "schema": "contacts",
      "description": "Global directory of contacts."
    },
    "admins/{adminId}": {
      "schema": "admins",
      "description": "Whitelisted administrators."
    },
    "users/{userId}": {
      "schema": "users",
      "description": "Authenticated users profiles."
    },
    "invitations/{email}": {
      "schema": "invitations",
      "description": "Pre-authorized user email roles."
    },
    "stages/{stageId}": {
      "schema": "stages",
      "description": "Configurable workflow stages."
    },
    "events/{eventId}": {
      "schema": "events",
      "description": "Outreach events for attendance tracking."
    },
    "contacts/{contactId}/interactions/{interactionId}": {
      "schema": "interactions",
      "description": "Logs of interactions with a contact."
    },
    "contacts/{contactId}/comments/{commentId}": {
      "schema": "comments",
      "description": "Comments left on a contact by team members."
    },
    "activities/{activityId}": {
      "schema": "activities",
      "description": "Global activity feed log."
    },
    "notifications/{notificationId}": {
      "schema": "notifications",
      "description": "Direct alerts for users."
    },
    "prayers/{prayerId}": {
      "schema": "prayers",
      "description": "Weekly prayer burdens and answers."
    },
    "tasks/{taskId}": {
      "schema": "tasks",
      "description": "Follow-up tasks associated with contacts."
    },
    "feedback/{feedbackId}": {
      "schema": "feedback",
      "description": "User submit bug reports and enhancement suggestions."
    },
    "webhook_logs/{logId}": {
      "schema": "webhook_logs",
      "description": "Incoming webhook delivery logs."
    },
    "coordination_notes/{noteId}": {
      "schema": "coordination_notes",
      "description": "Shared documents of meeting notes and actions for administrators with categories of regularity."
    }
  }
}
