{
  "entities": {
    "contacts": {
      "title": "Contact",
      "description": "A person involved in an outreach campaign.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "location": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "stage": { 
          "type": "string"
        },
        "lastSeen": { "type": "string" },
        "avatar": { "type": "string" },
        "initials": { "type": "string" },
        "status": { "type": "string" },
        "attendance": { "type": "object" },
        "approved": { "type": "boolean" }
      },
      "required": ["name", "email", "stage"]
    },
    "admins": {
      "title": "Admin",
      "description": "A user with administrative privileges.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["email"]
    },
    "users": {
        "title": "User",
        "description": "An authenticated user of the system.",
        "type": "object",
        "properties": {
            "email": { "type": "string" },
            "displayName": { "type": "string" },
            "photoURL": { "type": "string" },
            "approved": { "type": "boolean" },
            "role": { 
              "type": "string",
              "enum": ["admin", "manager", "operator", "viewer"]
            }
        },
        "required": ["email"]
    },
    "invitations": {
      "title": "Invitation",
      "description": "A pre-approved role and access assigned to an email.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "manager", "operator", "viewer"] },
        "approved": { "type": "boolean" },
        "invitedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "approved"]
    },
    "stages": {
      "title": "Stage",
      "description": "A workflow stage in the kanban board.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "color": { "type": "string" },
        "order": { "type": "integer" }
      },
      "required": ["label", "color", "order"]
    },
    "events": {
      "title": "Event",
      "description": "An outreach event for tracking attendance.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "date": { "type": "string" },
        "order": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "date", "order"]
    },
    "interactions": {
      "title": "Interaction",
      "description": "A log of an interaction with a contact.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "content": { "type": "string" },
        "dateTime": { "type": "string", "format": "date-time" },
        "duration": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "content", "dateTime", "createdAt"]
    },
    "comments": {
      "title": "Comment",
      "description": "A message left on a contact record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "text", "createdAt"]
    }
  },
  "firestore": {
    "contacts/{contactId}": {
      "schema": "contacts",
      "description": "Global directory of contacts."
    },
    "admins/{adminId}": {
      "schema": "admins",
      "description": "Whitelisted administrators."
    },
    "users/{userId}": {
      "schema": "users",
      "description": "Authenticated users profiles."
    },
    "invitations/{email}": {
      "schema": "invitations",
      "description": "Pre-authorized user email roles."
    },
    "stages/{stageId}": {
      "schema": "stages",
      "description": "Configurable workflow stages."
    },
    "events/{eventId}": {
      "schema": "events",
      "description": "Outreach events for attendance tracking."
    },
    "contacts/{contactId}/interactions/{interactionId}": {
      "schema": "interactions",
      "description": "Logs of interactions with a contact."
    },
    "contacts/{contactId}/comments/{commentId}": {
      "schema": "comments",
      "description": "Comments left on a contact by team members."
    }
  }
}
