{
  "mcpServers": {
    "cisa-work-tracker-local": {
      "command": "node",
      "args": [
        "mcp/node_modules/tsx/dist/cli.mjs",
        "mcp/src/stdio.ts"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "$GOOGLE_APPLICATION_CREDENTIALS",
        "FIREBASE_PROJECT_ID": "sac-campus-hub",
        "FIREBASE_DATABASE_ID": "prod"
      },
      "timeout": 30000,
      "trust": false
    }
  }
}
