# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_FIREBASE_API_KEY: Optional. Your Firebase Web API Key
# If set, it overrides the one in firebase-applet-config.json
VITE_FIREBASE_API_KEY=""

# VITE_FIREBASE_DATABASE_URL: Optional. Realtime Database URL, e.g.
# https://sac-campus-hub-default-rtdb.firebaseio.com (or the regional
# https://<db>.<region>.firebasedatabase.app form). Enables The Board's live
# collaborative editing. When unset, The Board falls back to Firestore-only
# editing (changes still sync on save, but without live multi-cursor editing).
VITE_FIREBASE_DATABASE_URL=""

# VITE_GITHUB_REPO: The GitHub owner/repository (e.g. Shir0o/cisa-campus-work-traker)
# Used to link feedback to GitHub issues in the admin panel and migration script.
VITE_GITHUB_REPO="Shir0o/cisa-campus-work-traker"

# TWILIO_AUTH_TOKEN: Your Twilio Auth Token. When set, inbound requests to
# /api/webhook/sms are verified against Twilio's X-Twilio-Signature header;
# when unset, verification is skipped (dev-only — do not leave unset in prod
# if SMS quick-add is enabled).
TWILIO_AUTH_TOKEN=""

# GROUPME_GROUP_ID: The GroupMe group id the bot lives in. When set, inbound
# requests to /api/webhook/groupme are rejected unless they carry this
# group_id (GroupMe callbacks have no signature, so this is the only inbound
# check available); when unset, any group's messages are accepted.
GROUPME_GROUP_ID=""

# GITHUB_TOKEN: Server-side GitHub token (needs `issues:write` on the target
# repo) used to auto-create/update GitHub issues from Send Feedback
# submissions. When unset, issue creation/sync is skipped silently (the
# manual "Create Issue"/"Link" fallback in the admin Feedback panel still
# works).
GITHUB_TOKEN=""

# GITHUB_REPO: owner/repo the server-side GitHub API calls target, e.g.
# Shir0o/cisa-campus-work-traker. Distinct from the client-facing
# VITE_GITHUB_REPO above, which only builds prefilled "New Issue" URLs.
GITHUB_REPO=""

# GITHUB_WEBHOOK_SECRET: verifies inbound GitHub webhook payloads'
# X-Hub-Signature-256 header at /api/webhook/github (issue closed/reopened
# syncs back to Firestore). When unset, verification is skipped (dev-only —
# do not leave unset in prod if the GitHub webhook is registered).
GITHUB_WEBHOOK_SECRET=""
