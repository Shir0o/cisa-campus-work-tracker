# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_FIREBASE_API_KEY: Optional. Your Firebase Web API Key
# If set, it overrides the one in firebase-applet-config.json
VITE_FIREBASE_API_KEY=""

# VITE_FIREBASE_FIRESTORE_DB_ID: Optional. Overrides the named Firestore
# database id from firebase-applet-config.json (default `prod`). Set to `qa-db`
# for a QA/staging build so the client SDK reads the isolated QA database.
VITE_FIREBASE_FIRESTORE_DB_ID=""

# VITE_FIREBASE_AUTH_DOMAIN: Optional. Overrides the Firebase Auth helper domain
# (issue #557). The app runs on Cloudflare Pages, NOT Firebase Hosting, so
# storage-partitioned Chrome/Safari can't read the cross-origin helper's initial
# state. Point this at the app's own domain (`cisa-campus-work-tracker.pages.dev`,
# `cisa-campus-work-tracker-qa.pages.dev` for QA) to use the same-origin
# `__/auth/*` reverse proxy in functions/__/auth. Requires the matching Google
# OAuth redirect URI first — see CLOUDFLARE_DEPLOYMENT.md.
VITE_FIREBASE_AUTH_DOMAIN=""

# VITE_FIREBASE_DATABASE_URL: Optional. Realtime Database URL, e.g.
# https://sac-campus-hub-default-rtdb.firebaseio.com (or the regional
# https://<db>.<region>.firebasedatabase.app form). Enables The Board's live
# collaborative editing. When unset, The Board falls back to Firestore-only
# editing (changes still sync on save, but without live multi-cursor editing).
VITE_FIREBASE_DATABASE_URL=""

# VITE_GITHUB_REPO: The GitHub owner/repository (e.g. Shir0o/cisa-campus-work-tracker)
# Used to link feedback to GitHub issues in the admin panel and migration script.
VITE_GITHUB_REPO="Shir0o/cisa-campus-work-tracker"

# GEMINI_API_KEY: Google Gemini API key for AI-powered parsing. Read on the
# backend by `server.ts` (see getAiClient() at server.ts:91) and consumed by:
#   POST /api/quick-add               (Siri / iOS Shortcuts / curl)
#   POST /api/webhook/groupme         (GroupMe bot !add / add: / /add)
#   POST /api/analyze-notes           (AI Notes Analyzer in coordination docs)
#   POST /api/smart-import/parse      (Smart Import modal in People directory)
#   POST /api/translate               (Translator endpoint)
#
# IMPORTANT — scope: this is a SERVER-SIDE secret. It belongs on the Cloud
# Run service that runs `server.ts` (the `campus-hub-backend` service in the
# `sac-campus-hub` project), NOT on Cloudflare Pages. The Cloudflare Pages
# function at functions/api/[[path]].ts is just a proxy that forwards every
# /api/* request to the Cloud Run backend via BACKEND_API_URL — it never reads
# this key. See CLOUDFLARE_DEPLOYMENT.md and server.test.ts for the contract.
#
# When unset, /api/quick-add/status reports `geminiConfigured: false` and every
# AI call above returns 500 with the message "GEMINI_API_KEY is not configured
# on the server". The Settings → "Quick add by text" panel surfaces a live badge
# so admins can self-verify the deployment.
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# TWILIO_AUTH_TOKEN: Your Twilio Auth Token. When set, inbound requests to

# GROUPME_GROUP_ID: The GroupMe group id the bot lives in. When set, inbound
# requests to /api/webhook/groupme are rejected unless they carry this
# group_id (GroupMe callbacks have no signature, so this is the only inbound
# check available); when unset, any group's messages are accepted.
GROUPME_GROUP_ID=""

# GROUPME_BOT_ID: The bot id used to post confirmations back to the GroupMe
# group after a successful !add / add: / /add quick-add. When unset, the
# webhook still quick-adds the contact but sends no chat confirmation.
GROUPME_BOT_ID=""

# GITHUB_TOKEN: Server-side GitHub token (needs `issues:write` on the target
# repo) used to auto-create/update GitHub issues from Send Feedback
# submissions. When unset, issue creation/sync is skipped silently (the
# manual "Create Issue"/"Link" fallback in the admin Feedback panel still
# works).
GITHUB_TOKEN=""

# GITHUB_REPO: owner/repo the server-side GitHub API calls target, e.g.
# Shir0o/cisa-campus-work-tracker. Distinct from the client-facing
# VITE_GITHUB_REPO above, which only builds prefilled "New Issue" URLs.
GITHUB_REPO=""

# GITHUB_WEBHOOK_SECRET: verifies inbound GitHub webhook payloads'
# X-Hub-Signature-256 header at /api/webhook/github (issue closed/reopened
# syncs back to Firestore). When unset, verification is skipped (dev-only —
# do not leave unset in prod if the GitHub webhook is registered).
GITHUB_WEBHOOK_SECRET=""

# EXPO_ACCESS_TOKEN: Server-side Expo push access token (Expo dashboard →
# project → Settings → Notifications → Access token). Authenticates the
# /api/send-push endpoint's call to Expo's push service. When unset, native
# push dispatch is skipped (pushSent:false) but the in-app bell still works.
EXPO_ACCESS_TOKEN=""
