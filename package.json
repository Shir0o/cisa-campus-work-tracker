{
  "name": "contact-manager-pro",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && mkdir -p dist/functions/api && cp -f functions/api/[[path]].ts dist/functions/api/ && mkdir -p dist/functions/__/auth dist/functions/__/firebase && cp -f functions/__/auth/[[path]].ts dist/functions/__/auth/ && cp -f functions/__/firebase/init.json.ts dist/functions/__/firebase/init.json.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:emulator": "npx firebase-tools emulators:exec --only auth,firestore \"npx tsx scripts/seed-emulator.ts && npx playwright test\"",
    "seed:emulator": "npx tsx scripts/seed-emulator.ts",
    "seed:e2e-users": "tsx scripts/seed-test-user-docs.ts",
    "seed:qa": "npx tsx scripts/seed-qa.ts",
    "sync:issues": "tsx scripts/sync-github-issues.ts",
    "check:i18n": "tsx scripts/check-hardcoded-ui-strings.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-collaboration": "^3.30.2",
    "@tiptap/extension-collaboration-caret": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extension-table-cell": "^3.30.2",
    "@tiptap/extension-table-header": "^3.30.2",
    "@tiptap/extension-table-row": "^3.30.2",
    "@tiptap/extension-task-item": "^3.30.2",
    "@tiptap/extension-task-list": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@vitejs/plugin-react": "^6.1.0",
    "chrono-node": "^2.10.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^11.0.2",
    "googleapis": "^176.0.0",
    "html2canvas-pro": "^2.0.4",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^13.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.9.0",
    "turndown": "^7.2.4",
    "vite": "^8.2.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.5"
  }
}
