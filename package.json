{
  "name": "contact-manager-pro",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run whats-new:compile && npm run help:compile && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && mkdir -p dist/functions/api && cp -f functions/api/[[path]].ts dist/functions/api/ && mkdir -p dist/functions/__/auth dist/functions/__/firebase && cp -f functions/__/auth/[[path]].ts dist/functions/__/auth/ && cp -f functions/__/firebase/init.json.ts dist/functions/__/firebase/init.json.ts",
    "whats-new:compile": "tsx scripts/compile-whats-new.ts",
    "help:compile": "tsx scripts/compile-help.ts",
    "whats-new:draft": "tsx scripts/draft-whats-new.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "test:e2e:emulator": "npm run functions:emulator-prep && bash scripts/run-e2e-emulator.sh",
    "seed:emulator": "npx tsx scripts/seed-emulator.ts",
    "seed:e2e-users": "tsx scripts/seed-test-user-docs.ts",
    "seed:qa": "npx tsx scripts/seed-qa.ts",
    "seed:bible-study": "tsx scripts/seed-bible-study.ts",
    "sync:issues": "tsx scripts/sync-github-issues.ts",
    "check:i18n": "tsx scripts/check-hardcoded-ui-strings.ts",
    "check:colors": "tsx scripts/check-hardcoded-colors.ts",
    "check:version": "tsx scripts/check-version.ts",
    "check:seams": "tsx scripts/check-seams.ts",
    "measure:bundle": "tsx scripts/measure-bundle.ts",
    "measure:bundle:mobile": "tsx scripts/measure-mobile-bundle.ts",
    "mobile:export": "npm --prefix apps/mobile run export:bundles",
    "metrics:scorecard": "tsx scripts/generate-scorecard.ts",
    "metrics:audit": "npm run build && npm run measure:bundle && npm run metrics:scorecard",
    "metrics:audit:mobile": "npm run mobile:export && npm run measure:bundle:mobile",
    "maintenance:discover": "tsx scripts/discover-improvements.ts",
    "maintenance:run": "tsx scripts/agent/runner.ts",
    "functions:emulator-prep": "npm --prefix firebase-functions ci && npm --prefix firebase-functions run build && node -e \"const f='firebase-functions/.secret.local';require('fs').existsSync(f)||require('fs').writeFileSync(f,'EXPO_ACCESS_TOKEN=emulator\\nVAPID_PRIVATE_KEY=emulator\\n')\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.31.0",
    "@sentry/react": "^11.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-collaboration-caret": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chrono-node": "^2.10.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.0",
    "googleapis": "^188.0.0",
    "html2canvas-pro": "^2.5.2",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.62.0",
    "motion": "^14.6.0",
    "qrcode.react": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
    "turndown": "^7.2.4",
    "vite": "^8.3.5",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@google-cloud/firestore": "^9.4.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "supertest": "^7.3.1",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
